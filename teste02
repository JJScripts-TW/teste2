        html += '<button id="jjopg-targets-copy" style="width:100%;padding:8px;background:#222;color:' + gold + ';font-weight:700;border:1px solid ' + gold + ';border-radius:8px;cursor:pointer;">📋 COPIAR COORDENADAS (' + targets.length + ')</button>';
        box.innerHTML = html;
        document.getElementById("jjopg-targets-copy").onclick = function () {
