        html += '<div style="color:#999;margin-bottom:4px;">Lista editável — apague as linhas dos jogadores/alvos já comprometidos e clique em "usar esta lista" antes de distribuir por proximidade.</div>';
        html += '<textarea id="jjopg-fulls-edit" style="width:100%;box-sizing:border-box;height:160px;padding:7px;margin-bottom:6px;background:#0d0f12;color:#eee;border:1px solid rgba(216,170,69,.4);border-radius:8px;resize:vertical;font-family:monospace;font-size:10px;">' + listText + '</textarea>';
