        };
    }
    // ---------------- rótulos com nome no mapa real ----------------
    let namedTargets = [];      // {name, coord, x, y}
    let namedLabelInterval = null;

    function parseNamedList(text) {
        // formatos aceitos, misturáveis livremente:
        //   "João:3 500|500 501|502 502|503"          -> todas as coordenadas do João precisam de 3 fulls
        //   "João:3 - 500|500 501|502 502|503"        -> mesma coisa, com um "-" separando nome/número das coordenadas
        //   "Maria 500|500:0 501|502:2"               -> número por coordenada individual (tem prioridade sobre o do nome)
        //   "Pedro:3 500|500:0 501|502"                -> mistura: 500|500 vira 0 (override), 501|502 usa o 3 padrão do Pedro
        //   "500|500*" ou "500|500:2*"                 -> "*" marca UMA coordenada específica como BÔNUS
        //   "Fulano:2 - 500|500 501|501 - Bonus: 502|502 503|503"  -> a palavra "Bonus" (maiúscula ou minúscula, em
        //       qualquer parte da linha) marca tudo que vem DEPOIS dela como alvo bônus; o que vem antes continua normal
        //   "Fulano:0 - BONUS - 500|500 501|501"       -> como não tem nenhuma coordenada antes de "BONUS", a linha inteira vira bônus
        //   sem nenhum ":N"                             -> usa o padrão configurado na Etapa 3
        //   Alvos bônus NUNCA precisam de fulls de apoio (não entram na distribuição), não importa o número que apareça.
        const lines = text.split("\n").map(function (l) { return l.trim(); }).filter(Boolean);
        const out = [];

        function extractCoords(segment) {
            const re = /(\d{1,3}\|\d{1,3})(?::(\d+))?(\*)?/g;
            const found = [];
            let m;
            while ((m = re.exec(segment)) !== null) {
                found.push({ coordStr: m[1], need: m[2] !== undefined ? parseInt(m[2], 10) : null, bonus: !!m[3] });
            }
            return found;
        }
        function nameAndDefaultFrom(part) {
            const trimmed = part.trim();
            const nm = trimmed.match(/^(.+?):(\d+)\s*-*\s*$/);
            if (nm) return { name: nm[1].trim(), lineDefault: parseInt(nm[2], 10) };
            // "Nome:N" (a letra N, sem número — "sem quantidade definida") conta como se não tivesse ":N"
            // nenhum, pra bater com o MESMO nome escrito sem ":N" em outra caixinha (ex: "- J J -:N" == "- J J -")
            const nMarker = trimmed.match(/^(.+?):[Nn]\s*-*\s*$/);
            if (nMarker) return { name: nMarker[1].trim() || "?", lineDefault: null };
            const cleaned = trimmed.replace(/-+\s*$/, "").trim();
            return { name: cleaned || "?", lineDefault: null };
        }

        lines.forEach(function (line) {
            // formato com seta (o que sai pronto da distribuição): "Nome → coord" ou "Nome → coord xN"
            // (o "xN" conta como N repetições da mesma coordenada, ex: "Arken → 497|629 x3")
            const arrowMatch = line.match(/^(.+?)\s*→\s*(\d{1,3}\|\d{1,3})\s*(?:\([^)]*\))?\s*(?:x(\d+))?\s*$/i);
            if (arrowMatch) {
                const pc = parseCoord(arrowMatch[2]);
                if (pc) {
                    const repeat = arrowMatch[3] ? parseInt(arrowMatch[3], 10) : 1;
                    for (let i = 0; i < repeat; i++) {
                        out.push({ name: arrowMatch[1].trim(), coord: pc.coord, x: pc.x, y: pc.y, need: null, bonus: false });
                    }
                }
                return;
            }
            const bonusIdx = line.search(/bonus/i);
            const beforeBonus = bonusIdx === -1 ? line : line.slice(0, bonusIdx);
            const afterBonus = bonusIdx === -1 ? "" : line.slice(bonusIdx + 5); // pula a palavra "bonus"

            const beforeCoords = extractCoords(beforeBonus);
            const firstIdx = beforeBonus.search(/\d{1,3}\|\d{1,3}/);
            const namePart = firstIdx === -1 ? beforeBonus : beforeBonus.slice(0, firstIdx);
            const nd = nameAndDefaultFrom(namePart);
            const name = nd.name, lineDefault = nd.lineDefault;

            beforeCoords.forEach(function (f) {
                const pc = parseCoord(f.coordStr);
                if (!pc) return;
                const need = f.bonus ? 0 : (f.need !== null ? f.need : lineDefault);
                out.push({ name: name, coord: pc.coord, x: pc.x, y: pc.y, need: need, bonus: !!f.bonus });
            });

            if (bonusIdx !== -1) {
                extractCoords(afterBonus).forEach(function (f) {
                    const pc = parseCoord(f.coordStr);
                    if (!pc) return;
                    out.push({ name: name, coord: pc.coord, x: pc.x, y: pc.y, need: 0, bonus: true });
                });
            }
        });
        return out;
    }

    function updateNamedLabels() {
        if (typeof TWMap === "undefined" || !TWMap.villages) return;
        namedTargets.forEach(function (t) {
            const v = TWMap.villages[t.x * 1000 + t.y];
            const labelId = "jj-oplabel-" + (v ? v.id : "c" + t.coord.replace("|", "_"));

            // aldeia não encontrada (ainda não carregada) ou setor foi descarregado pelo pan/zoom:
            // esconde o rótulo antigo em vez de deixá-lo "congelado" flutuando fora do lugar.
            const el = v && document.getElementById("map_village_" + v.id);
            if (!el) {
                const stale = document.getElementById(labelId);
                if (stale) stale.style.display = "none";
                return;
            }
            const r = el.getBoundingClientRect();
            // elemento existe no DOM mas está fora da área visível/renderizada (rect vazio) — mesmo tratamento
            if (!r || (r.width === 0 && r.height === 0 && r.top === 0 && r.left === 0)) {
                const stale2 = document.getElementById(labelId);
                if (stale2) stale2.style.display = "none";
                return;
            }

            el.style.filter = "brightness(220%) grayscale(100%)";

            let label = document.getElementById(labelId);
            if (!label) {
                label = document.createElement("div");
                label.id = labelId;
                label.style.cssText = "position:fixed;z-index:999997;background:#000;color:#ffd76b;font-size:10px;font-weight:800;padding:1px 5px;border-radius:4px;white-space:nowrap;pointer-events:none;border:1px solid " + gold + ";transform:translate(-50%,-130%);";
                document.body.appendChild(label);
            }
            label.style.display = "block";
            label.textContent = (t.bonus ? "🎁 " : "") + t.name;
            label.style.left = (r.left + r.width / 2) + "px";
            label.style.top = r.top + "px";
        });
    }

    document.getElementById("jjopg-names-mark").onclick = function () {
        const status = document.getElementById("jjopg-names-status");
        const parsed = parseNamedList(document.getElementById("jjopg-names").value);
        if (!parsed.length) { status.textContent = "Nenhuma linha válida (nome + coordenada) encontrada."; return; }

        // sempre alimenta a lista de alvos usada na Etapa 3 (distribuição), com nome e nº de fulls necessárias
        parsed.forEach(function (p) {
            const existingTarget = targets.find(function (t) { return t.coord === p.coord; });
            if (existingTarget) {
                existingTarget.owner = p.name;
                if (p.need !== null) existingTarget.needFulls = p.need;
                if (p.bonus) existingTarget.bonus = true;
            } else {
                targets.push({ coord: p.coord, x: p.x, y: p.y, owner: p.name, needFulls: p.need !== null ? p.need : undefined, bonus: !!p.bonus });
            }

            const existingNamed = namedTargets.find(function (t) { return t.coord === p.coord; });
            if (existingNamed) { existingNamed.name = p.name; existingNamed.need = p.need; }
            else namedTargets.push(p);
        });
        renderTargets();

        if (typeof TWMap === "undefined" || !TWMap.villages) {
            status.textContent = parsed.length + " alvo(s) adicionados à lista de distribuição. (Abra o mapa do jogo pra também ver os nomes marcados nas aldeias.)";
            return;
        }

        updateNamedLabels();
        if (namedLabelInterval) clearInterval(namedLabelInterval);
        namedLabelInterval = setInterval(updateNamedLabels, 250); // acompanha pan/zoom do mapa

        let notFound = 0;
        namedTargets.forEach(function (t) { if (!TWMap.villages[t.x * 1000 + t.y]) notFound++; });
        status.textContent = namedTargets.length + " alvo(s) marcados com nome no mapa." + (notFound ? " (" + notFound + " ainda não encontrados — pode ser que o setor não tenha carregado; navegue até lá)" : "");
    };

    document.getElementById("jjopg-names-clear").onclick = function () {
        if (namedLabelInterval) { clearInterval(namedLabelInterval); namedLabelInterval = null; }
        namedTargets.forEach(function (t) {
            if (typeof TWMap !== "undefined" && TWMap.villages) {
                const v = TWMap.villages[t.x * 1000 + t.y];
                if (v) {
                    const el = document.getElementById("map_village_" + v.id);
                    if (el) el.style.filter = "";
                    const label = document.getElementById("jj-oplabel-" + v.id);
                    if (label) label.remove();
                }
            }
            // também remove da lista de alvos usada na distribuição
            const idx = targets.findIndex(function (tg) { return tg.coord === t.coord; });
            if (idx >= 0) targets.splice(idx, 1);
        });
        namedTargets = [];
        renderTargets();
        document.getElementById("jjopg-names-status").textContent = "Nomes removidos do mapa e da lista de alvos.";
    };

    // ---------------- coletar coordenadas clicando direto no mapa real ----------------
    // Modo "coleta": com o botão ativado, clicar numa aldeia do mapa real guarda a coordenada dela
    // (marcando-a de amarelo transparente) sem precisar digitar nada. Serve pra aproveitar aldeias que
    // você já vê marcadas/abertas no mapa (ex: sem comando ainda) e juntar só essas coordenadas novas,
    // pra depois colar no campo de nome ali em cima. Clicar de novo na mesma aldeia desmarca.
    //
    // Usa a MESMA técnica do "Map Coord Picker" (script aprovado, de RedAlert/twscripts): troca
    // TWMap.map._handleClick pelo nosso, que lê a coordenada certa direto de this.coordByEvent(e) —
    // é o próprio método que o jogo usa internamente pro clique no mapa, então funciona clicando em
    // QUALQUER ponto do mapa (aldeia bárbara, aldeia com dono, etc.), sem precisar acertar um elemento
    // específico. A versão anterior tentava adivinhar por geometria e não funcionava direito.
    let collectMode = false;
    let collectedVillages = []; // {id, x, y, coord}

    // guarda o handler original do jogo numa variável GLOBAL (fora do closure deste script), pra
    // conseguir restaurar mesmo se o painel for fechado/reaberto sem desligar o modo coleta antes.
    if (typeof TWMap !== "undefined" && TWMap.map && window.__jjopgOrigHandleClick) {
        TWMap.map._handleClick = window.__jjopgOrigHandleClick;
        window.__jjopgOrigHandleClick = null;
    }

    function updateCollectStatus() {
        document.getElementById("jjopg-collect-copy").textContent = "📋 COPIAR COORDENADAS COLETADAS (" + collectedVillages.length + ")";
        const status = document.getElementById("jjopg-collect-status");
        if (collectMode) {
            status.textContent = "🟡 Modo coleta ATIVO — clique em qualquer ponto do mapa real. " + collectedVillages.length + " coletada(s) até agora.";
        } else {
            status.textContent = collectedVillages.length ? collectedVillages.length + " coordenada(s) coletada(s)." : "Modo coleta desligado.";
        }
    }

    function stopCollectMode() {
        collectMode = false;
        if (typeof TWMap !== "undefined" && TWMap.map && window.__jjopgOrigHandleClick) {
            TWMap.map._handleClick = window.__jjopgOrigHandleClick;
            window.__jjopgOrigHandleClick = null;
        }
        const btn = document.getElementById("jjopg-collect-toggle");
        if (btn) { btn.textContent = "🖱️ ATIVAR MODO COLETA NO MAPA"; btn.style.background = "#222"; }
    }

    document.getElementById("jjopg-collect-toggle").onclick = function () {
