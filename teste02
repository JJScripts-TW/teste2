        html += '<button id="jjopg-use-list" style="flex:1;padding:8px;background:' + gold + ';color:#111;font-weight:800;border:none;border-radius:8px;cursor:pointer;">✅ USAR ESTA LISTA</button>';
        html += '</div><div id="jjopg-uselist-status" style="color:#999;margin-top:6px;"></div>';
        box.innerHTML = html;

        document.getElementById("jjopg-copy").onclick = function () {
