javascript:(function () {

    const old = document.getElementById("jj-opgen");
    if (old) {
        old.remove();
        // se o modo coleta ficou ligado (fechou sem clicar em LIMPAR/desativar), devolve o clique do
        // mapa pro jogo, senão o mapa fica sem responder a clique normal depois que o painel some.
        if (typeof TWMap !== "undefined" && TWMap.map && window.__jjopgOrigHandleClick) {
            TWMap.map._handleClick = window.__jjopgOrigHandleClick;
            window.__jjopgOrigHandleClick = null;
        }
        return;
    }

    if (typeof game_data === "undefined" || !game_data.village) {
        alert("Abra qualquer página do jogo (com uma aldeia selecionada) antes de usar este script.");
        return;
    }

    const gold = "#f0b429"; // dourado "command center" (mantém o nome "gold" pra não quebrar as strings dinâmicas que já usam essa variável)
    const opLogoUri = "data:image/webp;base64,";
    const myVillageId = game_data.village.id;

    // ---------------- estado global do painel ----------------
    let ownFulls = [];      // {player, coord, x, y, axe, light, ram}
    let targets = [];       // {coord, x, y, owner}
    let assignments = [];   // {target, fulls:[{coord,x,y,player,dist,role}]}

    // ---------------- painel ----------------
    const panel = document.createElement("div");
    panel.id = "jj-opgen";
    panel.style.cssText = `
        position:fixed; z-index:999999; top:40px; right:8px;
        width:380px; max-width:94vw; max-height:90vh; overflow:auto; box-sizing:border-box;
        background:linear-gradient(160deg,#171106 0%,#0a0703 55%,#141005 100%);
        border:2px solid #f0b429; border-radius:6px;
        clip-path:polygon(18px 0,calc(100% - 18px) 0,100% 18px,100% calc(100% - 18px),calc(100% - 18px) 100%,18px 100%,0 calc(100% - 18px),0 18px);
        color:#f3e6c6; font-family:-apple-system,BlinkMacSystemFont,Verdana,Arial;
        box-shadow:0 0 0 1px #000, 0 0 0 4px rgba(240,180,41,.18), 0 0 36px rgba(240,180,41,.35), 0 16px 44px rgba(0,0,0,.85);
        font-size:11px;
    `;
    panel.innerHTML = `
        <style>
            #jj-opgen{--g:#f0b429;--gl:#ffe49a;--cut:9px;}
            #jj-opgen ::selection{background:rgba(240,180,41,.35);}
            #jj-opgen .sec{position:relative;border:1px solid rgba(240,180,41,.45);padding:9px 11px 10px;margin:0 0 10px;
                background:linear-gradient(180deg,rgba(240,180,41,.08) 0%,rgba(10,7,3,0) 50%),#0d0a05;
                box-shadow:0 0 0 1px #000,inset 0 0 14px rgba(240,180,41,.06);
                clip-path:polygon(var(--cut) 0,calc(100% - var(--cut)) 0,100% var(--cut),100% calc(100% - var(--cut)),calc(100% - var(--cut)) 100%,var(--cut) 100%,0 calc(100% - var(--cut)),0 var(--cut));}
            #jj-opgen .sec:before,#jj-opgen .sec:after{content:"";position:absolute;width:20px;height:20px;pointer-events:none;filter:drop-shadow(0 0 3px rgba(255,228,154,.8));}
            #jj-opgen .sec:before{left:-4px;top:-4px;border-left:3px solid var(--gl);border-top:3px solid var(--gl);}
            #jj-opgen .sec:after{right:-4px;bottom:-4px;border-right:3px solid var(--gl);border-bottom:3px solid var(--gl);}
            #jj-opgen summary{cursor:pointer;color:var(--g);font-weight:800;font-size:10.5px;list-style:none;padding:2px 0;text-transform:uppercase;letter-spacing:1px;text-shadow:0 0 9px rgba(240,180,41,.7),0 0 2px rgba(0,0,0,.8);}
            #jj-opgen summary::-webkit-details-marker{display:none;}
            #jj-opgen summary:before{content:"▸";display:inline-block;width:12px;color:var(--gl);text-shadow:0 0 6px rgba(255,228,154,.8);}
            #jj-opgen details[open]>summary:before{content:"▾";}
            #jj-opgen .secbody{margin-top:8px;}
            #jj-opgen label.l{display:block;color:#b99a5c;font-size:9px;margin-bottom:2px;text-transform:uppercase;letter-spacing:.5px;}
            #jj-opgen input.i,#jj-opgen textarea.t{width:100%;box-sizing:border-box;padding:6px 7px;background:#0a0805;color:#f7ecd2;border:1px solid rgba(240,180,41,.4);border-radius:2px;font-size:10.5px;}
            #jj-opgen input.i:focus,#jj-opgen textarea.t:focus{outline:none;border-color:var(--gl);box-shadow:0 0 0 1px rgba(255,228,154,.3),0 0 10px rgba(240,180,41,.4);}
            #jj-opgen textarea.t{font-family:ui-monospace,Menlo,monospace;font-size:10px;resize:vertical;}
            #jj-opgen .mb{margin-bottom:6px;}
            #jj-opgen .row{display:flex;gap:6px;}
            #jj-opgen .row>*{flex:1;min-width:0;}
            #jj-opgen .chk{display:flex;align-items:center;gap:6px;color:#b99a5c;font-size:10px;margin-bottom:6px;}
            #jj-opgen .chk input{accent-color:var(--g);}
            #jj-opgen button.b{width:100%;box-sizing:border-box;padding:8px 7px;font-weight:800;font-size:10px;cursor:pointer;text-transform:uppercase;letter-spacing:.6px;transition:filter .12s,box-shadow .12s;position:relative;
                clip-path:polygon(7px 0,calc(100% - 7px) 0,100% 7px,100% calc(100% - 7px),calc(100% - 7px) 100%,7px 100%,0 calc(100% - 7px),0 7px);}
            #jj-opgen button.b:hover{filter:brightness(1.22);}
            #jj-opgen button.b1{background:linear-gradient(180deg,#4a3610,#1c1406);color:var(--gl);border:1px solid var(--g);box-shadow:0 0 14px rgba(240,180,41,.55),inset 0 0 10px rgba(240,180,41,.18);}
            #jj-opgen button.b2{background:#0d0a05;color:#dcc17a;border:1px solid rgba(240,180,41,.55);box-shadow:inset 0 0 8px rgba(240,180,41,.12);}
            #jj-opgen button.b3{background:#170807;color:#f07a5a;border:1px solid rgba(240,122,90,.6);box-shadow:inset 0 0 8px rgba(240,122,90,.15);}
            #jj-opgen .status{color:#9a825a;font-size:9.5px;line-height:14px;margin:5px 0;}
            #jj-opgen details.help{margin-bottom:6px;}
            #jj-opgen details.help>summary{color:#786845;font-weight:500;font-size:9px;text-transform:none;letter-spacing:0;text-shadow:none;}
            #jj-opgen details.help>summary:before{content:"ℹ";color:var(--gl);text-shadow:0 0 4px rgba(255,228,154,.6);}
            #jj-opgen details.help[open]>summary:before{content:"ℹ";}
            #jj-opgen details.help p{color:#9a825a;font-size:9.5px;line-height:13px;margin:4px 0 0;}
            #jj-opgen hr.d{border:none;border-top:1px dashed rgba(240,180,41,.35);margin:8px 0;}
            #jj-opgen .subhead{color:var(--gl);font-weight:800;font-size:9.5px;margin-bottom:3px;text-transform:uppercase;letter-spacing:.6px;text-shadow:0 0 6px rgba(240,180,41,.5);}
            #jj-opgen .foot{text-align:center;color:#8a734a;font-size:8.5px;letter-spacing:1.5px;text-transform:uppercase;padding:10px 4px 4px;border-top:1px dashed rgba(240,180,41,.3);margin-top:2px;}
            #jj-opgen ::-webkit-scrollbar{width:8px;height:8px;}
            #jj-opgen ::-webkit-scrollbar-track{background:#080603;}
            #jj-opgen ::-webkit-scrollbar-thumb{background:var(--g);border-radius:0;}
        </style>
        <div id="jjopg-header" style="position:sticky;top:0;z-index:2;background:radial-gradient(ellipse at 50% -40%,rgba(240,180,41,.22),#0a0703 65%);border-bottom:2px solid var(--g);box-shadow:0 2px 14px rgba(240,180,41,.25);padding:12px 12px 10px;cursor:grab;user-select:none;">
            <span id="jjopg-x" style="position:absolute;top:8px;right:10px;z-index:5;cursor:pointer;color:var(--gl);font-size:12px;font-weight:800;padding:3px 8px;border:1px solid var(--g);background:#0d0a05;line-height:1;box-shadow:0 0 8px rgba(240,180,41,.4);pointer-events:auto;
                clip-path:polygon(5px 0,calc(100% - 5px) 0,100% 5px,100% calc(100% - 5px),calc(100% - 5px) 100%,5px 100%,0 calc(100% - 5px),0 5px);">✕</span>
            <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;width:100%;position:relative;pointer-events:none;">
                <img src="${opLogoUri}" alt="OP Planner" style="display:block;width:92px;height:92px;object-fit:contain;filter:drop-shadow(0 0 10px rgba(240,180,41,.55));">
                <div style="color:var(--gl);font-size:8.5px;letter-spacing:2.5px;text-transform:uppercase;opacity:.85;margin-top:-2px;">— Painel de Operações —</div>
            </div>
        </div>
        <div style="padding:9px 10px;">

            <details id="sec1" open class="sec">
                <summary>1️⃣ Importar Fulls + Semi-fulls da tribo</summary>
                <div class="secbody">
                    <label class="l">TAG da minha tribo</label>
                    <input id="jjopg-tag" class="i mb" placeholder="Ex: HNK">
                    <details class="help"><summary>Critério de FULL / SEMI-FULL</summary><p>FULL = aldeia que bate os mínimos abaixo. SEMI-FULL = abaixo disso mas ainda com tropa solta (senão é ignorada).</p></details>
                    <div class="row mb">
                        <div><label class="l">Mín. Machado</label><input id="jjopg-axe" class="i" type="number" value="0"></div>
                        <div><label class="l">Mín. Cav. Leve</label><input id="jjopg-light" class="i" type="number" value="0"></div>
                    </div>
                    <label class="chk"><input id="jjopg-ram" type="checkbox"> Exigir aríete p/ contar como FULL</label>
                    <div class="row mb">
                        <div><label class="l">Mín. Machado (semi)</label><input id="jjopg-semi-axe" class="i" type="number" value="0"></div>
                        <div><label class="l">Mín. Cav. Leve (semi)</label><input id="jjopg-semi-light" class="i" type="number" value="0"></div>
                    </div>
                    <button id="jjopg-import" class="b b1 mb">📥 IMPORTAR FULLS + SEMI-FULLS</button>
                    <div id="jjopg-status" class="status"></div>
                    <div id="jjopg-results"></div>
                </div>
            </details>

            <details id="sec4" class="sec">
                <summary>2️⃣ Colar coordenadas com nome e visualizar no mapa</summary>
                <div class="secbody">
                    <details class="help"><summary>Como escrever a lista</summary><p>Uma linha por jogador: nome + coordenadas. ":N" logo após o nome define quantos apoios cada coordenada da linha precisa (ex: "João:3 500|500 501|502" → todas precisam de 3). ":N" numa coordenada específica tem prioridade sobre o do nome. ":0" = não precisa de ajuda. Sem ":N" nenhum, usa o padrão da Etapa 3.</p></details>
                    <textarea id="jjopg-names" class="t mb" placeholder="João:3 500|500 501|502 502|503&#10;Maria:0 510|498 511|500&#10;Pedro:3 520|500:0 521|501" style="height:90px;"></textarea>
                    <div class="row mb">
                        <button id="jjopg-names-mark" class="b b1">🏷️ MARCAR NO MAPA</button>
                        <button id="jjopg-names-clear" class="b b3">🗑️ LIMPAR</button>
                    </div>
                    <div id="jjopg-names-status" class="status"></div>

                    <hr class="d">
                    <div class="subhead">🖱️ Coletar coordenadas clicando no mapa</div>
                    <details class="help"><summary>Como funciona</summary><p>Ative e clique em qualquer ponto do mapa real pra coletar a coordenada (fica marcada de amarelo transparente). Clique de novo na mesma aldeia pra desmarcar. Depois copie só as que você coletou agora e cole no campo de cima com o nome de quem vai atacar.</p></details>
                    <button id="jjopg-collect-toggle" class="b b2 mb">🖱️ ATIVAR MODO COLETA NO MAPA</button>
                    <div class="row mb">
                        <button id="jjopg-collect-copy" class="b b1">📋 COPIAR (0)</button>
                        <button id="jjopg-collect-clear" class="b b3">🗑️ LIMPAR</button>
                    </div>
                    <div id="jjopg-collect-status" class="status"></div>

                    <div id="jjopg-targets-box"></div>
                </div>
            </details>

            <details id="sec5" class="sec">
                <summary>3️⃣ Distribuir por quantidade disponível</summary>
                <div class="secbody">
                    <details class="help"><summary>Como funciona</summary><p>Sem cálculo de distância/mapa — só aloca por quantidade disponível de cada jogador (na ordem que aparecem na caixinha do pool) até cobrir o pedido de cada alvo.</p></details>

                    <label class="l">🎯 Alvos que precisam de distribuição</label>
                    <textarea id="jjopg-dist-targets-box" class="t mb" placeholder="João:3 500|500 501|502 502|503&#10;Maria:0 510|498&#10;Pedro:2 520|500 - Bonus: 521|501" style="height:90px;"></textarea>
                    <details class="help"><summary>Formato da caixa acima</summary><p><code>Nome:N coord coord coord</code> (":N" = quantos apoios cada alvo do Nome precisa; sem ":N" usa o padrão abaixo). Bônus: escreva "Bonus" em qualquer parte da linha — tudo depois vira alvo bônus (nunca precisa de apoio).</p></details>

                    <label class="l">🛡️ Fulls/semis disponíveis (por jogador)</label>
                    <textarea id="jjopg-dist-pool-box" class="t mb" placeholder="Pedro 10 F 5 S&#10;Maria 6 F 2 S" style="height:80px;"></textarea>
                    <details class="help"><summary>Formato da caixa acima</summary><p>Cola direto do jogo: <code>Nome &lt;F&gt; F &lt;S&gt; S</code> (ex: <code>Pedro 10 F 5 S</code>). Sem coordenada — é só a quantidade disponível de cada um.</p></details>

                    <div class="row mb">
                        <div><label class="l">Mín. apoios/alvo (padrão)</label><input id="jjopg-minfulls" class="i" type="number" value="1" min="1"></div>
                        <div style="display:flex;align-items:flex-end;"><label class="chk" style="margin-bottom:6px;"><input id="jjopg-skip-bonus" type="checkbox"> Ocultar 🎁 bônus</label></div>
                    </div>
                    <button id="jjopg-distribute" class="b b1 mb">🎯 GERAR DISTRIBUIÇÃO</button>
                    <div id="jjopg-dist-status" class="status"></div>
                    <div id="jjopg-dist-results"></div>
                </div>
            </details>

            <details id="sec5b" class="sec">
                <summary>3️⃣.2 Distribuir proporcionalmente (rodada 2)</summary>
                <div class="secbody">
                    <details class="help"><summary>Como funciona</summary><p>Caixinha própria e independente da de cima. Pega TODO o pool disponível e espalha igualzinho entre as coordenadas — 1 apoio pra cada, se sobrar dá 2 pra cada, e assim por diante. Não puxa nada automático.</p></details>

                    <label class="l">📍 Coordenadas (só coordenadas, sem nome nem número)</label>
                    <textarea id="jjopg-dist-targets-box-2" class="t mb" placeholder="494|620 492|620 489|620&#10;487|621 488|619 487|618" style="height:80px;"></textarea>

                    <label class="l">👥 Pool disponível para esta rodada (Nome F S)</label>
                    <textarea id="jjopg-dist-pool-box-2" class="t mb" placeholder="Arken 0 F 10 S&#10;Minatto 0 F 14 S" style="height:80px;"></textarea>
                    <details class="help"><summary>De onde vem o pool</summary><p>Pode ser a sobra da rodada 1 (copie do campo "♻️ Sobra" ali de cima) ou qualquer outra lista <code>Nome F S</code>. TODO o pool é usado, dividido igualmente entre as coordenadas.</p></details>

                    <button id="jjopg-distribute-2" class="b b1 mb">🌓 DISTRIBUIR (RODADA 2)</button>
                    <div id="jjopg-dist-status-2" class="status"></div>
                    <div id="jjopg-dist-results-2"></div>
                </div>
            </details>

            <details id="sec7" class="sec">
                <summary>4️⃣ Gerador de Mensagem da Operação</summary>
                <div class="secbody">
                    <details class="help"><summary>Como funciona</summary><p>Seção 100% manual — cole/edite as caixas abaixo com o plano final e clique em "GERAR MENSAGEM". Modelo padrão fixo — só data e horário mudam.</p></details>
                    <div class="row mb">
                        <div><label class="l">Data da OP</label><input id="jjopg-op-date" class="i" placeholder="29/09/2026"></div>
                        <div><label class="l">Horário de impacto</label><input id="jjopg-op-time" class="i" placeholder="12:05:00.000"></div>
                    </div>
                    <label class="l">👑 Alvos NT (nobre)</label>
                    <textarea id="jjopg-mp-nt" class="t mb" placeholder="500|500 (Pedro) → 480|480" style="height:56px;"></textarea>

                    <label class="l">🎭 Alvos Fakes coordenados</label>
                    <textarea id="jjopg-mp-fakes" class="t mb" placeholder="500|502 (Pedro) → 481|480 (fake nobre)" style="height:56px;"></textarea>

                    <label class="l">⚔️ Fulls — nick e alvos</label>
                    <textarea id="jjopg-mp-fulls" class="t mb" style="height:56px;"></textarea>

                    <label class="l">🌓 Semi-fulls — nick e alvos</label>
                    <textarea id="jjopg-mp-semis" class="t mb" style="height:56px;"></textarea>

                    <label class="l">🎁 Alvos Bônus</label>
                    <textarea id="jjopg-mp-bonus" class="t mb" style="height:56px;"></textarea>

                    <button id="jjopg-genmp" class="b b1 mb">✉️ GERAR MENSAGEM DA OPERAÇÃO</button>
                    <div id="jjopg-mp-status" class="status"></div>
                    <div id="jjopg-mp-results"></div>

                    <hr class="d">
                    <div class="status" style="margin:0 0 6px;">Mesmo conteúdo das caixas acima, separado num aviso individual por jogador.</div>
                    <button id="jjopg-genmp-ind" class="b b1 mb">✉️✉️ GERAR MENSAGENS INDIVIDUAIS</button>
                    <div id="jjopg-mp-ind-status" class="status"></div>
                    <div id="jjopg-mp-ind-results"></div>
                </div>
            </details>

            <details id="sec8" class="sec">
                <summary>5️⃣ Visualizar plano no mapa mundial</summary>
                <div class="secbody">
                    <details class="help"><summary>Como funciona</summary><p>Abre o mapa mundial (com a diplomacia da tribo já carregada) e destaca por cima: 🎯 alvos NT em amarelo, 🎭 fakes em branco, 🎁 bônus em verde claro — lidos das caixas de NT/FAKES/BÔNUS da Etapa 4. Passe o mouse num alvo pra ver o nome.</p></details>
                    <button id="jjopg-showmap" class="b b1">🗺️ ABRIR MAPA MUNDIAL COM OS ALVOS</button>
                </div>
            </details>

            <details id="sec9" class="sec" style="margin-bottom:2px;">
                <summary>6️⃣ Exportar plano final</summary>
                <div class="secbody">
                    <div class="row mb">
                        <button id="jjopg-export-copy" class="b b1">📋 COPIAR TABELA</button>
                        <button id="jjopg-export-file" class="b b2">⬇️ BAIXAR .TXT</button>
                    </div>
                    <div id="jjopg-export-status" class="status"></div>
                </div>
            </details>

            <div class="foot">Foco • Disciplina • Vitória</div>
        </div>
    `;
    document.body.appendChild(panel);
    document.getElementById("jjopg-x").onclick = function (e) {
        e.stopPropagation();
        if (typeof namedLabelInterval !== "undefined" && namedLabelInterval) clearInterval(namedLabelInterval);
        document.querySelectorAll('[id^="jj-oplabel-"]').forEach(function (el) { el.remove(); });
        if (typeof stopCollectMode === "function") stopCollectMode(); // devolve o clique do mapa pro jogo
        panel.remove();
    };

    // ---------------- arrastar o painel pelo cabeçalho ----------------
    (function enableDrag() {
        const header = document.getElementById("jjopg-header");
        let dragging = false, offsetX = 0, offsetY = 0;

        header.addEventListener("mousedown", function (e) {
            if (e.target.id === "jjopg-x" || e.target.closest("#jjopg-x")) return; // não arrasta clicando no X
            const rect = panel.getBoundingClientRect();
            // troca de "ancorado na direita" pra "ancorado em left/top" só no primeiro drag,
            // senão o painel fica preso na borda direita mesmo movendo o mouse.
            panel.style.left = rect.left + "px";
            panel.style.top = rect.top + "px";
            panel.style.right = "auto";
            panel.style.bottom = "auto";
            offsetX = e.clientX - rect.left;
            offsetY = e.clientY - rect.top;
            dragging = true;
            header.style.cursor = "grabbing";
            e.preventDefault();
        });

        document.addEventListener("mousemove", function (e) {
            if (!dragging) return;
            const rect = panel.getBoundingClientRect();
            let newLeft = e.clientX - offsetX;
            let newTop = e.clientY - offsetY;
            newLeft = Math.max(-rect.width + 60, Math.min(window.innerWidth - 60, newLeft));
            newTop = Math.max(0, Math.min(window.innerHeight - 40, newTop));
            panel.style.left = newLeft + "px";
            panel.style.top = newTop + "px";
        });

        document.addEventListener("mouseup", function () {
            if (!dragging) return;
            dragging = false;
            header.style.cursor = "grab";
        });
    })();

    // ---------------- helpers genéricos ----------------
    async function fetchText(url) {
        const r = await fetch(url, { credentials: "same-origin" });
        return await r.text();
    }
    function parseCSV(text) {
        return text.trim().split("\n").filter(Boolean).map(function (line) { return line.split(","); });
    }
    function decodeName(s) {
        try { return decodeURIComponent(String(s).replace(/\+/g, " ")); }
        catch (e) { return s; }
    }
    function parseCoord(str) {
        const m = String(str).match(/(\d{1,3})\|(\d{1,3})/);
        if (!m) return null;
        return { x: parseInt(m[1], 10), y: parseInt(m[2], 10), coord: m[0] };
    }
    function dist(a, b) {
        return Math.sqrt(Math.pow(a.x - b.x, 2) + Math.pow(a.y - b.y, 2));
    }
    async function getTribeMembers(tag) {
        const allyText = await fetchText("/map/ally.txt");
        const allies = parseCSV(allyText);
        const match = allies.find(function (a) { return decodeName(a[2]).toLowerCase() === tag.toLowerCase(); });
        if (!match) return null;
        const allyId = match[0];
        const playerText = await fetchText("/map/player.txt");
        const players = parseCSV(playerText);
        return players.filter(function (p) { return p[2] === allyId; })
            .map(function (p) { return { id: p[0], name: decodeName(p[1]) }; });
    }
    function findHeaderRow(table) {
        const rows = table.querySelectorAll("tr");
        for (let i = 0; i < rows.length; i++) { if (rows[i].querySelector("img")) return rows[i]; }
        return rows[0] || null;
    }
    function findTroopTable(doc) {
        const tables = Array.from(doc.querySelectorAll("table.vis"));
        return tables.find(function (t) { const hr = findHeaderRow(t); return hr && hr.querySelector("img"); });
    }
    function findUnitColumns(headerRow) {
        const cells = Array.from(headerRow.children);
        const map = {};
        cells.forEach(function (cell, idx) {
            let key = cell.getAttribute("data-unit");
            const img = cell.querySelector("img");
            if (!key && img && img.src) {
                const m = img.src.match(/unit_(\w+)\.(png|webp|gif)/i);
                if (m) key = m[1];
            }
            if (key) map[key] = idx;
        });
        return map;
    }
    function copyText(btn, text) {
        navigator.clipboard.writeText(text).then(function () {
            const orig = btn.textContent;
            btn.textContent = "✅ Copiado!";
            setTimeout(function () { btn.textContent = orig; }, 1400);
        }).catch(function () { prompt("Copie manualmente:", text); });
    }

    // ================= SEÇÃO 1: IMPORTAR FULLS + SEMI-FULLS =================
    function fullLineText(r) {
        return r.coord + " - " + r.player + " - " + r.type + " (M:" + r.axe + " CL:" + r.light + (r.ram ? " AR:" + r.ram : "") + ")";
    }

    // parser compartilhado: transforma o texto (editado ou colado) de volta em objetos {coord,x,y,player,type,axe,light,ram}
    function parseFullsListText(raw) {
        const lines = raw.split("\n").map(function (l) { return l.trim(); }).filter(Boolean);
        const parsed = [];
        lines.forEach(function (line) {
            const m = line.match(/^(\d{1,3}\|\d{1,3})\s*-\s*(.+?)\s*-\s*(FULL|SEMI)\b\s*(?:\(M:(\d+)\s*CL:(\d+)(?:\s*AR:(\d+))?\))?/i);
            if (!m) return;
            const pc = parseCoord(m[1]);
            if (!pc) return;
            parsed.push({
                coord: pc.coord, x: pc.x, y: pc.y,
                player: m[2].trim(),
                type: m[3].toUpperCase(),
                axe: m[4] ? parseInt(m[4], 10) : 0,
                light: m[5] ? parseInt(m[5], 10) : 0,
                ram: m[6] ? parseInt(m[6], 10) : 0
            });
        });
        return parsed;
    }

    // Cota de F/S por jogador: reconhece o formato colado do jogo "Nome<F> F <S> S" (sem espaço entre o
    // nome e o número de F). Usa os nomes já importados na Etapa 1 (mais longo primeiro) pra separar
    // certo onde o nome termina e o número começa — nomes que já têm dígito no fim (ex: "Cinder7")
    // só ficam certos com essa lista; sem ela, cai num heurístico "nome mínimo" que pode errar nesses casos.
    function knownPlayerNames() {
        const set = {};
        ownFulls.forEach(function (f) { set[f.player] = true; });
        return Object.keys(set);
    }
    function parsePlayerQuota(text, knownNames) {
        const names = (knownNames || []).slice().sort(function (a, b) { return b.length - a.length; });
        const lines = text.split("\n").map(function (l) { return l.trim(); }).filter(Boolean);
        const out = [];
        lines.forEach(function (line) {
            let entry = null;
            // tenta os nomes conhecidos (do mais longo pro mais curto); só aceita se o resto bater com "<F> F <S> S"
            for (let i = 0; i < names.length && !entry; i++) {
                const n = names[i];
                if (line.toLowerCase().indexOf(n.toLowerCase()) === 0) {
                    const rest = line.slice(n.length);
                    const m = rest.match(/^\s*(\d+)\s*F\s*(\d+)\s*S\s*$/i);
                    if (m) entry = { player: n, fullQuota: parseInt(m[1], 10), semiQuota: parseInt(m[2], 10), matched: true };
                }
            }
            if (!entry) {
                const m = line.match(/^(.+?)\s*(\d+)\s*F\s*(\d+)\s*S\s*$/i);
                if (m) entry = { player: m[1].trim(), fullQuota: parseInt(m[2], 10), semiQuota: parseInt(m[3], 10), matched: false };
            }
            if (entry) out.push(entry);
        });
        return out;
    }

    async function importFulls() {
        const tag = document.getElementById("jjopg-tag").value.trim();
        const minAxe = parseInt(document.getElementById("jjopg-axe").value, 10) || 0;
        const minLight = parseInt(document.getElementById("jjopg-light").value, 10) || 0;
        const needRam = document.getElementById("jjopg-ram").checked;
        const semiMinAxe = parseInt(document.getElementById("jjopg-semi-axe").value, 10) || 0;
        const semiMinLight = parseInt(document.getElementById("jjopg-semi-light").value, 10) || 0;
        const status = document.getElementById("jjopg-status");
        const resultsBox = document.getElementById("jjopg-results");
        resultsBox.innerHTML = "";
        if (!tag) { status.textContent = "Digite a TAG da sua tribo."; return; }

        status.textContent = "Buscando membros da tribo...";
        let members;
        try { members = await getTribeMembers(tag); }
        catch (e) { status.textContent = "Erro ao buscar dados da tribo."; console.error(e); return; }
        if (!members) { status.textContent = "Tribo não encontrada. Confira a TAG."; return; }
        if (!members.length) { status.textContent = "Tribo sem membros listados."; return; }

        status.textContent = "Lendo tropas... (0/" + members.length + ")";
        const results = [];
        let done = 0, errs = 0;

        for (const member of members) {
            try {
                const url = "/game.php?screen=ally&mode=members_troops&player_id=" + member.id + "&village=" + myVillageId;
                const html = await fetchText(url);
                const doc = new DOMParser().parseFromString(html, "text/html");
                const table = findTroopTable(doc);
                if (table) {
                    const headerRow = findHeaderRow(table);
                    const cols = findUnitColumns(headerRow);
                    const rows = Array.from(table.querySelectorAll("tr")).filter(function (r) { return r !== headerRow; });
                    rows.forEach(function (row) {
                        const cells = row.children;
                        function getVal(key) {
                            const idx = cols[key];
                            if (idx === undefined || !cells[idx]) return 0;
                            const v = parseInt(cells[idx].textContent.replace(/\D/g, ""), 10);
                            return isNaN(v) ? 0 : v;
                        }
                        const axe = getVal("axe"), light = getVal("light"), ram = getVal("ram");
                        const pc = parseCoord(row.textContent);
                        if (!pc) return;
                        if (axe === 0 && light === 0 && ram === 0) return;

                        const isFull = axe >= minAxe && light >= minLight && (!needRam || ram > 0);
                        let type;
                        if (isFull) {
                            type = "FULL";
                        } else if (axe >= semiMinAxe && light >= semiMinLight) {
                            type = "SEMI";
                        } else {
                            return; // abaixo do mínimo pra contar até como semi-full — ignora
                        }
                        results.push({ player: member.name, coord: pc.coord, x: pc.x, y: pc.y, axe: axe, light: light, ram: ram, type: type });
                    });
                } else { errs++; }
            } catch (e) { errs++; console.warn("Falha ao ler tropas de", member.name, e); }
            done++;
            status.textContent = "Lendo tropas... (" + done + "/" + members.length + ")";
            await new Promise(function (r) { setTimeout(r, 120); });
        }

        ownFulls = results;
        const nFull = results.filter(function (r) { return r.type === "FULL"; }).length;
        const nSemi = results.length - nFull;
        status.textContent = "Concluído. " + nFull + " full(s) e " + nSemi + " semi-full(s)." + (errs ? " (" + errs + " falha(s) de leitura)" : "");
        renderFullsResults();
    }

