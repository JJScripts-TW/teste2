javascript:(function(){

var old=document.getElementById("jj-fs-mp");
if(old){old.remove();return;}

var CFGKEY="jjfsmp_cfg";
var CFG=JSON.parse(localStorage.getItem(CFGKEY)||'{}');
if(!CFG.dia)CFG.dia="22";
if(!CFG.hora)CFG.hora="22:59:59:900";

function salvarCFG(){
localStorage.setItem(CFGKEY,JSON.stringify(CFG));
}

var d=document.createElement("div");
d.id="jj-fs-mp";
d.style="position:fixed;top:60px;right:10px;width:420px;max-height:88vh;overflow:auto;z-index:999999;background:#181818;border:2px solid #d8aa45;border-radius:10px;color:#eee;font:13px Arial;padding:12px;box-shadow:0 0 18px #000";

d.innerHTML=`
<div style="display:flex;justify-content:space-between;align-items:center">
<b style="color:#f0c65d;font-size:17px">JJ — FULLS / SEMI-FULLS</b>
<b id="jjfsx" style="cursor:pointer;color:#f66;font-size:18px">✕</b>
</div>

<div style="margin-top:10px;color:#ff6666"><b>🔴 LISTA DE FULLS</b></div>

<textarea id="jjfsfull"
placeholder="► Arken — 73 fulls no total
   600|451 — 5 fulls
   592|451 — 5 fulls"
style="width:100%;height:165px;box-sizing:border-box;margin-top:5px;background:#252525;color:#fff;border:1px solid #555;border-radius:5px;padding:7px"></textarea>

<div style="margin-top:10px;color:#f0a040"><b>🟠 LISTA DE SEMI-FULLS</b></div>

<textarea id="jjfssemi"
placeholder="► Arken — 10 semi fulls no total
   601|451 — 3 semi fulls
   602|451 — 2 semi-fulls"
style="width:100%;height:165px;box-sizing:border-box;margin-top:5px;background:#252525;color:#fff;border:1px solid #555;border-radius:5px;padding:7px"></textarea>

<div style="margin-top:10px;color:#f0c65d"><b>⏰ HORÁRIO DE CHEGADA DOS ATAQUES</b></div>

<div style="display:flex;gap:6px;margin-top:5px">
<input id="jjfsdia" placeholder="dia (ex: 22)" value="${CFG.dia}"
style="flex:1;background:#252525;color:#fff;border:1px solid #555;border-radius:5px;padding:7px;box-sizing:border-box">
<input id="jjfshora" placeholder="hh:mm:ss:ms" value="${CFG.hora}"
style="flex:2;background:#252525;color:#fff;border:1px solid #555;border-radius:5px;padding:7px;box-sizing:border-box">
</div>

<button id="jjfsgo"
style="width:100%;margin-top:12px;padding:10px;background:#d8aa45;color:#111;border:0;border-radius:6px;font-weight:bold;cursor:pointer">
GERAR MPs
</button>

<div id="jjfsout" style="margin-top:12px"></div>
`;

document.body.appendChild(d);

document.getElementById("jjfsx").onclick=function(){
d.remove();
};

function parseLista(txt){

var jogadores={};
var atual=null;

txt.split(/\r?\n/).forEach(function(linha){

linha=linha.trim();

if(!linha)return;


/* LINHAS DAS ALDEIAS — checadas ANTES do cabeçalho, porque uma
coordenada ("600|451 — 5 fulls") também bate no padrão genérico
de cabeçalho ("nome — N fulls"). Só tratamos como cabeçalho se a
linha NÃO começar com uma coordenada.
Aceita:
600|451 — 5 fulls
600|451 — 5 semi fulls
600|451 — 5 semi-fulls
600|451 — 5 semifulls
600|451 — 5
*/

var ehCoordenada=/^\d{3}\|\d{3}\b/.test(linha);

if(ehCoordenada){

var coord=linha.match(
/(\d{3}\|\d{3})\s*[—–-]\s*(\d+)(?:\s*(?:semi[\s-]*fulls?|semifulls?|fulls?))?/i
);

if(coord && atual){

jogadores[atual].aldeias.push({
coord:coord[1],
qtd:parseInt(coord[2],10)
});

}

return;
}


/* CABEÇALHO DO JOGADOR
Aceita:
► Arken — 73 fulls no total
► Arken — 10 semi fulls no total
► Arken — 10 semi-fulls no total
► Arken — 10 semifulls no total
*/

var head=linha.match(
/^►?\s*(.+?)\s*[—–-]\s*(\d+)\s*(?:semi[\s-]*fulls?|semifulls?|fulls?|parci[ae]is?|ataques?|alvos?)\b.*$/i
);

if(head){

atual=head[1].trim();

if(!jogadores[atual]){
jogadores[atual]={
total:0,
aldeias:[]
};
}

jogadores[atual].total=parseInt(head[2],10);

return;
}


/* FORMATO SIMPLES TAMBÉM ACEITO
Arken — 600|451, 592|451
*/

var simples=linha.match(/^(.+?)\s*[—–-]\s*(.+)$/);

if(simples){

var nome=simples[1].replace(/^►\s*/,"").trim();
var coords=simples[2].match(/\d{3}\|\d{3}/g);

if(coords){

if(!jogadores[nome]){
jogadores[nome]={
total:0,
aldeias:[]
};
}

coords.forEach(function(c){

jogadores[nome].aldeias.push({
coord:c,
qtd:1
});

jogadores[nome].total++;

});

}

}

});

return jogadores;
}


function esc(s){
return String(s)
.replace(/&/g,"&amp;")
.replace(/</g,"&lt;")
.replace(/>/g,"&gt;");
}


function totalAtaques(obj){

if(!obj || !obj.aldeias)return 0;

return obj.aldeias.reduce(function(t,a){
return t+a.qtd;
},0);

}


function linhas(obj){

if(!obj || !obj.aldeias || !obj.aldeias.length){
return "Nenhum";
}

return obj.aldeias.map(function(a,i){

return (i+1)+". "+a.coord+" — "+a.qtd+
(a.qtd===1?" ataque":" ataques");

}).join("\n");

}


document.getElementById("jjfsgo").onclick=function(){

CFG.dia=(document.getElementById("jjfsdia").value||"22").trim();
CFG.hora=(document.getElementById("jjfshora").value||"22:59:59:900").trim();
salvarCFG();

var horarioTxt=
"• Os ataques devem chegar no dia "+CFG.dia+" às "+CFG.hora+
" CRAVADO — não pode passar desse horário.\n"+
"• Se cair um pouco adiantado ou atrasado, não precisa cancelar.";

var F=parseLista(
document.getElementById("jjfsfull").value
);

var S=parseLista(
document.getElementById("jjfssemi").value
);

var mapa={};

Object.keys(F).forEach(function(n){
mapa[n]=1;
});

Object.keys(S).forEach(function(n){
mapa[n]=1;
});





var jogadores=Object.keys(mapa);

if(!jogadores.length){

alert("Nenhum jogador encontrado nas listas.");

return;

}


var out=document.getElementById("jjfsout");

out.innerHTML=
'<div style="color:#8f8;margin-bottom:10px"><b>'+
jogadores.length+
' jogadores encontrados</b></div>';


jogadores.forEach(function(nome){

var full=F[nome]||{
total:0,
aldeias:[]
};

var semi=S[nome]||{
total:0,
aldeias:[]
};

var totalF=totalAtaques(full);
var totalS=totalAtaques(semi);


var body=
`[b]⚔️ OP — FULLS E SEMI-FULLS ⚔️[/b]

Abaixo estão os ataques que você deverá utilizar na operação.

━━━━━━━━━━━━━━━━━━

[b]🔴 FULLS — ${totalF}[/b]

${linhas(full)}

━━━━━━━━━━━━━━━━━━

[b]🟠 SEMI-FULLS — ${totalS}[/b]

${linhas(semi)}

━━━━━━━━━━━━━━━━━━

[b]📌 INSTRUÇÕES[/b]

• Não utilizar esses ataques fora da OP.
• Mantenha os FULLS e SEMI-FULLS reservados.
• Aguarde a distribuição dos alvos.
• Não altere ou espalhe nenhuma informação da operação.
${horarioTxt}

[b]⚠️ Siga exatamente as instruções recebidas para a OP.[/b]`;


var box=document.createElement("div");

box.style=
"background:#222;border:1px solid #555;border-radius:6px;padding:9px;margin-bottom:8px";


box.innerHTML=

'<div style="display:flex;justify-content:space-between;align-items:center">'+

'<b style="color:#f0c65d">'+
esc(nome)+
'</b>'+

'<span style="font-size:11px;color:#aaa">'+

'🔴 '+totalF+
' | 🟠 '+totalS+

'</span>'+

'</div>'+

'<div style="font-size:11px;color:#999;margin-top:3px">'+

'Fulls: '+full.aldeias.length+
' aldeias | Semi: '+
semi.aldeias.length+
' aldeias'+

'</div>'+

'<button style="width:100%;margin-top:7px;padding:7px;background:#444;color:#fff;border:0;border-radius:4px;cursor:pointer">COPIAR MP</button>';


box.querySelector("button").onclick=function(){

var b=this;

navigator.clipboard.writeText(body).then(function(){

b.textContent="✓ COPIADO";

setTimeout(function(){

b.textContent="COPIAR MP";

},1000);

});

};


out.appendChild(box);

});


var copiarTudo=document.createElement("button");

copiarTudo.textContent="COPIAR TODAS AS MPs";

copiarTudo.style=
"width:100%;padding:9px;background:#d8aa45;color:#111;border:0;border-radius:5px;font-weight:bold;cursor:pointer;margin-top:5px";


copiarTudo.onclick=function(){

var tudo="";

jogadores.forEach(function(nome){

var full=F[nome]||{
total:0,
aldeias:[]
};

var semi=S[nome]||{
total:0,
aldeias:[]
};

var totalF=totalAtaques(full);
var totalS=totalAtaques(semi);

tudo+=
`==============================
JOGADOR: ${nome}
==============================

[b]⚔️ OP — FULLS E SEMI-FULLS ⚔️[/b]

[b]🔴 FULLS — ${totalF}[/b]

${linhas(full)}

[b]🟠 SEMI-FULLS — ${totalS}[/b]

${linhas(semi)}

[b]📌 INSTRUÇÕES[/b]

• Não utilizar esses ataques fora da OP.
• Mantenha os FULLS e SEMI-FULLS reservados.
• Aguarde a distribuição dos alvos.
• Não altere ou espalhe nenhuma informação da operação.
${horarioTxt}

[b]⚠️ Siga exatamente as instruções recebidas para a OP.[/b]


`;

});


navigator.clipboard.writeText(tudo).then(function(){

copiarTudo.textContent="✓ TODAS COPIADAS";

setTimeout(function(){

copiarTudo.textContent="COPIAR TODAS AS MPs";

},1200);

});

};


out.appendChild(copiarTudo);

};

})();
