    // ---------------- helpers genéricos ----------------
    async function fetchText(url) {
        const r = await fetch(url, { credentials: "same-origin" });
        return await r.text();
    }
    function parseCSV(text) {
        return text.trim().split("\n").filter(Boolean).map(function (line) { return line.split(","); });
    }
    function decodeName(s) {
        try { return decodeURIComponent(String(s).replace(/\+/g, " ")); }
        catch (e) { return s; }
    }
    function parseCoord(str) {
        const m = String(str).match(/(\d{1,3})\|(\d{1,3})/);
        if (!m) return null;
        return { x: parseInt(m[1], 10), y: parseInt(m[2], 10), coord: m[0] };
    }
    function dist(a, b) {
        return Math.sqrt(Math.pow(a.x - b.x, 2) + Math.pow(a.y - b.y, 2));
    }
    async function getTribeMembers(tag) {
        const allyText = await fetchText("/map/ally.txt");
        const allies = parseCSV(allyText);
        const match = allies.find(function (a) { return decodeName(a[2]).toLowerCase() === tag.toLowerCase(); });
        if (!match) return null;
        const allyId = match[0];
        const playerText = await fetchText("/map/player.txt");
        const players = parseCSV(playerText);
        return players.filter(function (p) { return p[2] === allyId; })
            .map(function (p) { return { id: p[0], name: decodeName(p[1]) }; });
    }
    function findHeaderRow(table) {
        const rows = table.querySelectorAll("tr");
        for (let i = 0; i < rows.length; i++) { if (rows[i].querySelector("img")) return rows[i]; }
        return rows[0] || null;
    }
    function findTroopTable(doc) {
        const tables = Array.from(doc.querySelectorAll("table.vis"));
        return tables.find(function (t) { const hr = findHeaderRow(t); return hr && hr.querySelector("img"); });
    }
    function findUnitColumns(headerRow) {
        const cells = Array.from(headerRow.children);
        const map = {};
        cells.forEach(function (cell, idx) {
            let key = cell.getAttribute("data-unit");
            const img = cell.querySelector("img");
            if (!key && img && img.src) {
                const m = img.src.match(/unit_(\w+)\.(png|webp|gif)/i);
                if (m) key = m[1];
            }
            if (key) map[key] = idx;
        });
        return map;
    }
    function copyText(btn, text) {
        navigator.clipboard.writeText(text).then(function () {
            const orig = btn.textContent;
            btn.textContent = "✅ Copiado!";
            setTimeout(function () { btn.textContent = orig; }, 1400);
        }).catch(function () { prompt("Copie manualmente:", text); });
    }

    // ================= SEÇÃO 1: IMPORTAR FULLS =================
    async function importFulls() {
        const tag = document.getElementById("jjopg-tag").value.trim();
        const minAxe = parseInt(document.getElementById("jjopg-axe").value, 10) || 0;
        const minLight = parseInt(document.getElementById("jjopg-light").value, 10) || 0;
        const needRam = document.getElementById("jjopg-ram").checked;
        const status = document.getElementById("jjopg-status");
        const resultsBox = document.getElementById("jjopg-results");
        resultsBox.innerHTML = "";
        if (!tag) { status.textContent = "Digite a TAG da sua tribo."; return; }

        status.textContent = "Buscando membros da tribo...";
        let members;
        try { members = await getTribeMembers(tag); }
        catch (e) { status.textContent = "Erro ao buscar dados da tribo."; console.error(e); return; }
        if (!members) { status.textContent = "Tribo não encontrada. Confira a TAG."; return; }
        if (!members.length) { status.textContent = "Tribo sem membros listados."; return; }

        status.textContent = "Lendo tropas... (0/" + members.length + ")";
        const results = [];
        let done = 0, errs = 0;

        for (const member of members) {
            try {
                const url = "/game.php?screen=ally&mode=members_troops&player_id=" + member.id + "&village=" + myVillageId;
                const html = await fetchText(url);
                const doc = new DOMParser().parseFromString(html, "text/html");
                const table = findTroopTable(doc);
                if (table) {
                    const headerRow = findHeaderRow(table);
                    const cols = findUnitColumns(headerRow);
                    const rows = Array.from(table.querySelectorAll("tr")).filter(function (r) { return r !== headerRow; });
                    rows.forEach(function (row) {
                        const cells = row.children;
                        function getVal(key) {
                            const idx = cols[key];
                            if (idx === undefined || !cells[idx]) return 0;
                            const v = parseInt(cells[idx].textContent.replace(/\D/g, ""), 10);
                            return isNaN(v) ? 0 : v;
                        }
                        const axe = getVal("axe"), light = getVal("light"), ram = getVal("ram");
                        const pc = parseCoord(row.textContent);
                        if (!pc) return;
                        const isFull = axe >= minAxe && light >= minLight && (!needRam || ram > 0);
                        if (isFull && (axe > 0 || light > 0 || ram > 0)) {
                            results.push({ player: member.name, coord: pc.coord, x: pc.x, y: pc.y, axe: axe, light: light, ram: ram });
                        }
                    });
                } else { errs++; }
            } catch (e) { errs++; console.warn("Falha ao ler tropas de", member.name, e); }
            done++;
            status.textContent = "Lendo tropas... (" + done + "/" + members.length + ")";
            await new Promise(function (r) { setTimeout(r, 120); });
        }

        ownFulls = results;
        status.textContent = "Concluído. " + results.length + " full(s)." + (errs ? " (" + errs + " falha(s) de leitura)" : "");
        renderFullsResults();
    }
    function renderFullsResults() {
        const box = document.getElementById("jjopg-results");
        if (!ownFulls.length) { box.innerHTML = '<div style="color:#999;">Nenhuma full encontrada.</div>'; return; }
        const byPlayer = {};
        ownFulls.forEach(function (r) { byPlayer[r.player] = (byPlayer[r.player] || 0) + 1; });
        let html = '<div style="max-height:180px;overflow:auto;margin-bottom:8px;border:1px solid rgba(216,170,69,.2);border-radius:8px;">';
        Object.keys(byPlayer).sort(function (a, b) { return byPlayer[b] - byPlayer[a]; }).forEach(function (p) {
            html += '<div style="display:flex;justify-content:space-between;padding:5px 8px;border-bottom:1px solid rgba(216,170,69,.12);"><span>' + p + '</span><b style="color:' + gold + ';">' + byPlayer[p] + '</b></div>';
        });
        html += '</div><button id="jjopg-copy" style="width:100%;padding:8px;background:#222;color:' + gold + ';font-weight:700;border:1px solid ' + gold + ';border-radius:8px;cursor:pointer;">📋 COPIAR LISTA (' + ownFulls.length + ')</button>';
        box.innerHTML = html;
        document.getElementById("jjopg-copy").onclick = function () {
            const text = ownFulls.map(function (r) { return r.coord + " - " + r.player + " (M:" + r.axe + " CL:" + r.light + (r.ram ? " AR:" + r.ram : "") + ")"; }).join("\n");
            copyText(this, text);
        };
    }
    document.getElementById("jjopg-import").onclick = importFulls;

    // ================= SEÇÃO 2: IMPORTAR DEFESAS =================
    async function importDefesas() {
        const tag = document.getElementById("jjopg-tag").value.trim();
        const status = document.getElementById("jjopg-def-status");
        const resultsBox = document.getElementById("jjopg-def-results");
        resultsBox.innerHTML = "";
        if (!tag) { status.textContent = "Preencha a TAG na Etapa 1 primeiro."; return; }

        status.textContent = "Buscando membros da tribo...";
        let members;
        try { members = await getTribeMembers(tag); }
        catch (e) { status.textContent = "Erro ao buscar dados da tribo."; console.error(e); return; }
        if (!members) { status.textContent = "Tribo não encontrada."; return; }

        status.textContent = "Lendo defesas... (0/" + members.length + ")";
        const results = [];
        let done = 0;

        for (const member of members) {
            try {
                const url = "/game.php?screen=ally&mode=members_troops&player_id=" + member.id + "&village=" + myVillageId;
                const html = await fetchText(url);
                const doc = new DOMParser().parseFromString(html, "text/html");
                const table = findTroopTable(doc);
                if (table) {
                    const headerRow = findHeaderRow(table);
                    const cols = findUnitColumns(headerRow);
                    const rows = Array.from(table.querySelectorAll("tr")).filter(function (r) { return r !== headerRow; });
                    rows.forEach(function (row) {
                        const cells = row.children;
                        function getVal(key) {
                            const idx = cols[key];
                            if (idx === undefined || !cells[idx]) return 0;
                            const v = parseInt(cells[idx].textContent.replace(/\D/g, ""), 10);
                            return isNaN(v) ? 0 : v;
                        }
                        const spear = getVal("spear"), sword = getVal("sword"), archer = getVal("archer"), heavy = getVal("heavy");
                        const pc = parseCoord(row.textContent);
                        if (!pc) return;
                        if (spear + sword + archer + heavy > 0) {
                            results.push({ player: member.name, coord: pc.coord, x: pc.x, y: pc.y, spear: spear, sword: sword, archer: archer, heavy: heavy });
                        }
                    });
                }
            } catch (e) { console.warn("Falha ao ler defesa de", member.name, e); }
            done++;
            status.textContent = "Lendo defesas... (" + done + "/" + members.length + ")";
            await new Promise(function (r) { setTimeout(r, 120); });
        }

        ownDef = results;
        status.textContent = "Concluído. " + results.length + " aldeia(s) com defesa.";
        let html = '<div style="max-height:180px;overflow:auto;border:1px solid rgba(216,170,69,.2);border-radius:8px;">';
        results.sort(function (a, b) { return (b.spear + b.sword + b.archer + b.heavy) - (a.spear + a.sword + a.archer + a.heavy); });
        results.forEach(function (r) {
            html += '<div style="padding:5px 8px;border-bottom:1px solid rgba(216,170,69,.12);">' + r.coord + ' - ' + r.player +
                ' <span style="color:#999;">(L:' + r.spear + ' E:' + r.sword + ' Aq:' + r.archer + ' CP:' + r.heavy + ')</span></div>';
        });
        html += '</div>';
        resultsBox.innerHTML = html;
    }
    document.getElementById("jjopg-import-def").onclick = importDefesas;

    // ================= SEÇÃO 3: COLETAR ALVOS POR K =================
    function computeK(x, y) { return Math.floor(y / 100) * 10 + Math.floor(x / 100); }

    async function collectByK() {
        const tag = document.getElementById("jjopg-etag").value.trim();
        const k = parseInt(document.getElementById("jjopg-k").value, 10);
        const status = document.getElementById("jjopg-k-status");
        const box = document.getElementById("jjopg-k-results");
        box.innerHTML = "";
        if (!tag || isNaN(k)) { status.textContent = "Preencha a TAG inimiga e o K."; return; }

        status.textContent = "Buscando dados...";
        try {
            const allyText = await fetchText("/map/ally.txt");
            const allies = parseCSV(allyText);
            const allyMatch = allies.find(function (a) { return decodeName(a[2]).toLowerCase() === tag.toLowerCase(); });
            if (!allyMatch) { status.textContent = "Tribo inimiga não encontrada."; return; }
            const allyId = allyMatch[0];

            const playerText = await fetchText("/map/player.txt");
            const players = parseCSV(playerText);
            const playerIds = {};
            players.forEach(function (p) { if (p[2] === allyId) playerIds[p[0]] = decodeName(p[1]); });

            const villageText = await fetchText("/map/village.txt");
            const villages = parseCSV(villageText);
            const found = [];
            villages.forEach(function (v) {
                const x = parseInt(v[2], 10), y = parseInt(v[3], 10), playerId = v[4];
                if (playerId && playerIds[playerId] && computeK(x, y) === k) {
                    found.push({ coord: x + "|" + y, x: x, y: y, owner: playerIds[playerId] });
                }
            });

            targets = found;
            status.textContent = "Concluído. " + found.length + " aldeia(s) encontrada(s) no K" + k + ".";
            renderTargets();
        } catch (e) { status.textContent = "Erro ao coletar alvos."; console.error(e); }
    }
    function renderTargets() {
        const box = document.getElementById("jjopg-k-results");
        if (!targets.length) { box.innerHTML = '<div style="color:#999;">Nenhum alvo coletado.</div>'; return; }
        const byPlayer = {};
        targets.forEach(function (t) { byPlayer[t.owner] = (byPlayer[t.owner] || 0) + 1; });
        let html = '<div style="max-height:150px;overflow:auto;margin-bottom:8px;border:1px solid rgba(216,170,69,.2);border-radius:8px;">';
        Object.keys(byPlayer).sort(function (a, b) { return byPlayer[b] - byPlayer[a]; }).forEach(function (p) {
            html += '<div style="display:flex;justify-content:space-between;padding:5px 8px;border-bottom:1px solid rgba(216,170,69,.12);"><span>' + p + '</span><b style="color:' + gold + ';">' + byPlayer[p] + '</b></div>';
        });
        html += '</div><button id="jjopg-k-copy" style="width:100%;padding:8px;background:#222;color:' + gold + ';font-weight:700;border:1px solid ' + gold + ';border-radius:8px;cursor:pointer;">📋 COPIAR COORDENADAS (' + targets.length + ')</button>';
        box.innerHTML = html;
        document.getElementById("jjopg-k-copy").onclick = function () {
            const text = targets.map(function (t) { return t.coord + " - " + t.owner; }).join("\n");
            copyText(this, text);
        };
    }
    document.getElementById("jjopg-collect-k").onclick = collectByK;

    // ================= SEÇÃO 4: COLAR COORDENADAS =================
    document.getElementById("jjopg-paste-add").onclick = function () {
        const text = document.getElementById("jjopg-paste").value;
        const matches = text.match(/\d{1,3}\|\d{1,3}/g) || [];
        let added = 0;
        matches.forEach(function (m) {
            const pc = parseCoord(m);
            if (pc && !targets.find(function (t) { return t.coord === pc.coord; })) {
                targets.push({ coord: pc.coord, x: pc.x, y: pc.y, owner: "(manual)" });
                added++;
            }
        });
        document.getElementById("jjopg-paste-status").textContent = added + " coordenada(s) adicionada(s) aos alvos. Total: " + targets.length + ".";
        renderTargets();
    };
    document.getElementById("jjopg-paste-mark").onclick = function () {
        const status = document.getElementById("jjopg-paste-status");
        if (typeof TWMap === "undefined" || !TWMap.villages) {
            status.textContent = "Abra o mapa do jogo (screen=map) para destacar as aldeias.";
            return;
        }
