(function () {
    var gold = "#d8aa45";
    var goldLight = "#f0c65d";
 
    var old = document.getElementById("jj-fulls-import");
    if (old) { old.remove(); return; }
 
    function inputStyle() {
        return "width:100%;box-sizing:border-box;padding:8px;color:#eee;background:#0d0f12;" +
               "border:1px solid rgba(216,170,69,.38);border-radius:8px;font-size:10px;outline:none;";
    }
 
    var panel = document.createElement("div");
    panel.id = "jj-fulls-import";
    panel.style.cssText =
        "position:fixed;z-index:999999;top:50px;right:8px;width:320px;max-width:92vw;" +
        "max-height:86vh;overflow:auto;box-sizing:border-box;" +
        "background:linear-gradient(145deg,#17191d 0%,#08090c 52%,#121419 100%);" +
        "border:1px solid #8a6728;border-radius:14px;color:#eee;" +
        "font-family:-apple-system,BlinkMacSystemFont,Verdana,Arial;" +
        "box-shadow:0 14px 42px rgba(0,0,0,.74);";
 
    panel.innerHTML =
        '<div id="jjfi-h" style="display:flex;align-items:center;justify-content:space-between;padding:10px 12px;background:linear-gradient(135deg,#191b1f,#090a0c 70%);border-radius:13px 13px 0 0;border-bottom:1px solid rgba(216,170,69,.45);touch-action:none;">' +
            '<div style="color:' + goldLight + ';font-size:13px;font-weight:800;">⚔️ IMPORTAR FULLS</div>' +
            '<span id="jjfi-x" style="width:24px;height:24px;display:flex;align-items:center;justify-content:center;color:#ddd;font-size:13px;border:1px solid rgba(216,170,69,.4);border-radius:6px;background:#111318;cursor:pointer;">✕</span>' +
        '</div>' +
        '<div style="padding:10px;">' +
            '<div style="color:#aaa;font-size:9px;margin-bottom:4px;">MINHA TRIBO (TAG)</div>' +
            '<input id="jjfi-tag" placeholder="Ex: JJ" style="' + inputStyle() + '">' +
 
            '<div style="display:grid;grid-template-columns:1fr 1fr;gap:5px;margin-top:6px;">' +
                '<div><div style="color:#aaa;font-size:8px;margin-bottom:3px;">MÍN. MACHADO</div><input id="jjfi-min-axe" type="number" value="5000" style="' + inputStyle() + '"></div>' +
                '<div><div style="color:#aaa;font-size:8px;margin-bottom:3px;">MÍN. CAV. LEVE</div><input id="jjfi-min-light" type="number" value="1000" style="' + inputStyle() + '"></div>' +
            '</div>' +
            '<div style="display:flex;align-items:center;gap:6px;margin-top:6px;">' +
                '<input id="jjfi-require-ram" type="checkbox" style="width:14px;height:14px;">' +
                '<label for="jjfi-require-ram" style="color:#aaa;font-size:9px;">Exigir aríete presente</label>' +
            '</div>' +
 
            '<button id="jjfi-btn" style="width:100%;margin-top:9px;padding:9px;background:' + gold + ';color:#111;border:none;border-radius:8px;font-weight:800;font-size:11px;cursor:pointer;">⚔️ IMPORTAR FULLS</button>' +
 
            '<div id="jjfi-status" style="margin-top:9px;color:#aaa;font-size:9px;line-height:15px;"></div>' +
            '<div id="jjfi-result" style="margin-top:7px;"></div>' +
            '<button id="jjfi-copy" style="width:100%;margin-top:7px;padding:7px;background:#202329;color:#eee;border:1px solid rgba(216,170,69,.5);border-radius:8px;font-size:9px;font-weight:700;cursor:pointer;display:none;">📋 COPIAR LISTA</button>' +
        '</div>';
 
    document.body.appendChild(panel);
    document.getElementById("jjfi-x").onclick = function () { panel.remove(); };
 
    function decodeName(raw) {
        try { return decodeURIComponent(raw.replace(/\+/g, " ")); } catch (e) { return raw; }
    }
    function fetchText(url) { return fetch(url).then(function (r) { return r.text(); }); }
 
    function findUnitColumnIndex(table, unitKey) {
        var headerCells = table.querySelectorAll("thead th, tr:first-child th");
        var index = -1;
        headerCells.forEach(function (th, i) {
            var unitEl = th.querySelector("[data-unit]");
            var img = th.querySelector("img");
            var isMatchByData = unitEl && unitEl.getAttribute("data-unit") === unitKey;
            var isMatchByImg = img && new RegExp("unit_" + unitKey, "i").test(img.getAttribute("src") || "");
            if (isMatchByData || isMatchByImg) index = i;
        });
        return index;
    }
 
    function currentVillageId() {
        try { if (window.game_data && game_data.village) return game_data.village.id; } catch (e) {}
        return "0";
    }
 
    var lastCopyText = "";
 
    document.getElementById("jjfi-btn").onclick = function () {
        var myTag = document.getElementById("jjfi-tag").value.trim();
        var statusEl = document.getElementById("jjfi-status");
        var resultEl = document.getElementById("jjfi-result");
        var copyBtn = document.getElementById("jjfi-copy");
        resultEl.innerHTML = "";
        copyBtn.style.display = "none";
 
        var minAxe = parseInt(document.getElementById("jjfi-min-axe").value, 10) || 0;
        var minLight = parseInt(document.getElementById("jjfi-min-light").value, 10) || 0;
        var requireRam = document.getElementById("jjfi-require-ram").checked;
        var PARTIAL_PCT = 0.7;
 
        if (!myTag) { statusEl.innerHTML = "⚠️ Digite a TAG da tribo."; return; }
 
        statusEl.innerHTML = "🔎 Buscando tribo \"" + myTag + "\"...";
 
        fetchText("/map/ally.txt").then(function (allyText) {
            var lines = allyText.split("\n");
            var myAllyId = null, myAllyName = null;
            for (var i = 0; i < lines.length; i++) {
                var line = lines[i].trim();
                if (!line) continue;
                var cols = line.split(",");
                if (cols.length < 3) continue;
                if (decodeName(cols[2]).toLowerCase() === myTag.toLowerCase()) {
                    myAllyId = cols[0];
                    myAllyName = decodeName(cols[1]);
                    break;
                }
            }
 
            if (!myAllyId) { statusEl.innerHTML = "⚠️ Tribo \"" + myTag + "\" não encontrada em /map/ally.txt."; return; }
 
            fetchText("/map/player.txt").then(function (playerText) {
                var pLines = playerText.split("\n");
                var myPlayersList = [];
                for (var j = 0; j < pLines.length; j++) {
                    var pline = pLines[j].trim();
                    if (!pline) continue;
                    var pcols = pline.split(",");
                    if (pcols.length < 3) continue;
                    if (pcols[2] === myAllyId) myPlayersList.push({ id: pcols[0], name: decodeName(pcols[1]) });
                }
 
                if (!myPlayersList.length) { statusEl.innerHTML = "⚠️ Nenhum jogador encontrado na tribo " + myAllyName + "."; return; }
 
                var villageId = currentVillageId();
                var perPlayer = {};
                myPlayersList.forEach(function (p) { perPlayer[p.name] = { disponivel: 0, parcial: 0 }; });
 
                var parseErrors = 0;
                var index = 0;
 
                function processNext() {
                    if (index >= myPlayersList.length) { finish(); return; }
                    var p = myPlayersList[index];
                    index++;
                    statusEl.innerHTML = "⚔️ Buscando tropas: " + index + "/" + myPlayersList.length + " (" + p.name + ")...";
 
                    var url = "/game.php?screen=ally&mode=members_troops&player_id=" + p.id + "&village=" + villageId;
 
                    fetch(url, { credentials: "same-origin" })
                        .then(function (res) { return res.text(); })
                        .then(function (html) {
                            var doc = new DOMParser().parseFromString(html, "text/html");
                            var candidateTables = doc.querySelectorAll("table.vis");
                            var table = null;
                            candidateTables.forEach(function (t) {
                                if (table) return;
                                var hRow = t.querySelector("thead tr") || t.querySelector("tr:first-child");
                                if (hRow && hRow.querySelector("img")) table = t;
                            });
                            if (!table) { parseErrors++; processNext(); return; }
 
                            var axeIdx = findUnitColumnIndex(table, "axe");
                            var lightIdx = findUnitColumnIndex(table, "light");
                            var ramIdx = findUnitColumnIndex(table, "ram");
                            if (axeIdx === -1 || lightIdx === -1) { parseErrors++; processNext(); return; }
 
                            var rows = table.querySelectorAll("tr");
                            var headerRow = table.querySelector("thead tr") || table.querySelector("tr:first-child");
                            rows.forEach(function (row) {
                                if (row.querySelector("th") || row === headerRow) return;
                                var cells = row.querySelectorAll("td");
                                var rowText = row.textContent || "";
                                if (!/\d{1,3}\|\d{1,3}/.test(rowText)) return;
 
                                function cellNum(idx) {
                                    if (idx === -1 || !cells[idx]) return 0;
                                    var n = parseInt((cells[idx].textContent || "0").replace(/\D/g, ""), 10);
                                    return isNaN(n) ? 0 : n;
                                }
 
                                var axe = cellNum(axeIdx);
                                var light = cellNum(lightIdx);
                                var ram = ramIdx !== -1 ? cellNum(ramIdx) : null;
 
                                var axePct = minAxe ? axe / minAxe : 1;
                                var lightPct = minLight ? light / minLight : 1;
                                var ramOk = !requireRam || (ram !== null && ram > 0);
 
                                if (axe >= minAxe && light >= minLight && ramOk) {
                                    perPlayer[p.name].disponivel++;
                                } else if ((axePct >= PARTIAL_PCT || lightPct >= PARTIAL_PCT) && (axe > 0 || light > 0)) {
                                    perPlayer[p.name].parcial++;
                                }
                            });
 
                            processNext();
                        })
                        .catch(function () { parseErrors++; processNext(); });
                }
 
                function finish() {
                    var names = Object.keys(perPlayer)
                        .filter(function (n) { return perPlayer[n].disponivel > 0 || perPlayer[n].parcial > 0; })
                        .sort(function (a, b) { return perPlayer[b].disponivel - perPlayer[a].disponivel; });
 
                    var totalDisp = 0, totalParc = 0;
                    names.forEach(function (n) { totalDisp += perPlayer[n].disponivel; totalParc += perPlayer[n].parcial; });
 
                    if (!names.length) {
                        statusEl.innerHTML = "✅ Importação concluída. Nenhum full disponível ou parcial encontrado." +
                            (parseErrors ? "<br>⚠️ " + parseErrors + " jogador(es) não puderam ser lidos." : "");
                        return;
                    }
 
                    var html = '<div style="padding:7px;background:rgba(15,17,21,.9);border:1px solid rgba(216,170,69,.28);border-radius:8px;font-size:9px;margin-bottom:5px;">' +
                        '<div style="color:' + goldLight + ';font-weight:800;">' + myAllyName + ' [' + myTag + ']</div>' +
                        '<div style="color:#ccc;">✅ Total disponível: <b>' + totalDisp + '</b> &nbsp; 🟡 Total parcial: <b>' + totalParc + '</b></div>' +
                        (parseErrors ? '<div style="color:#d66;margin-top:3px;">⚠️ ' + parseErrors + ' jogador(es) não puderam ser lidos.</div>' : '') +
                    '</div>';
 
                    var copyLines = [myAllyName + " [" + myTag + "] — Fulls importados", ""];
 
                    names.forEach(function (name) {
                        var d = perPlayer[name];
                        html += '<div style="margin:3px 0;padding:6px 7px;background:rgba(15,17,21,.9);border:1px solid rgba(216,170,69,.28);border-radius:7px;font-size:9px;display:flex;justify-content:space-between;">' +
                            '<b style="color:' + goldLight + '">' + name + '</b>' +
                            '<span style="color:#ccc;">✅ ' + d.disponivel + ' &nbsp; 🟡 ' + d.parcial + '</span>' +
                        '</div>';
                        copyLines.push(name + " — Disponível: " + d.disponivel + " | Parcial: " + d.parcial);
                    });
 
                    lastCopyText = copyLines.join("\n");
                    resultEl.innerHTML = html;
                    copyBtn.style.display = "block";
                    statusEl.innerHTML = "✅ Importação concluída.";
                }
 
                processNext();
            }).catch(function (e) { statusEl.innerHTML = "❌ Erro ao baixar player.txt: " + e.message; });
        }).catch(function (e) { statusEl.innerHTML = "❌ Erro ao baixar ally.txt: " + e.message; });
    };
 
    document.getElementById("jjfi-copy").onclick = function () {
        var ta = document.createElement("textarea");
        ta.value = lastCopyText;
        ta.style.position = "fixed";
        ta.style.opacity = "0";
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand("copy"); } catch (e) {}
        ta.remove();
        var btn = document.getElementById("jjfi-copy");
        btn.textContent = "✅ Copiado!";
        setTimeout(function () { btn.textContent = "📋 COPIAR LISTA"; }, 1300);
    };
 
    // arrastar
    var header = document.getElementById("jjfi-h");
    var sx = 0, sy = 0, iL = 0, iT = 0, dragging = false, moved = false;
    function pt(e) {
        if (e.touches && e.touches.length) return e.touches[0];
        if (e.changedTouches && e.changedTouches.length) return e.changedTouches[0];
        return e;
    }
    function start(e) {
        if (e.target && e.target.closest && e.target.closest("#jjfi-x")) return;
        var p = pt(e);
        var r = panel.getBoundingClientRect();
        sx = p.clientX; sy = p.clientY; iL = r.left; iT = r.top;
        dragging = true; moved = false;
    }
    function move(e) {
        if (!dragging) return;
        var p = pt(e);
        var dx = p.clientX - sx, dy = p.clientY - sy;
        if (!moved) {
            if (Math.abs(dx) < 6 && Math.abs(dy) < 6) return;
            panel.style.left = iL + "px";
            panel.style.top = iT + "px";
            panel.style.right = "auto";
            moved = true;
        }
        if (e.cancelable) e.preventDefault();
        panel.style.left = Math.max(0, Math.min(iL + dx, window.innerWidth - panel.offsetWidth)) + "px";
        panel.style.top = Math.max(0, Math.min(iT + dy, window.innerHeight - 50)) + "px";
    }
    function end() { dragging = false; moved = false; }
    header.addEventListener("touchstart", start, { passive: true });
    header.addEventListener("touchmove", move, { passive: false });
    header.addEventListener("touchend", end, { passive: true });
    header.addEventListener("mousedown", start);
    document.addEventListener("mousemove", move);
    document.addEventListener("mouseup", end);
})();
