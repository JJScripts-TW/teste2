    // ---------------- Mensagens INDIVIDUAIS (uma por jogador, com nome + botão de copiar) ----------------
    // As 4 caixinhas usam o MESMO formato da Etapa 2/3 ("Nome:N - coord coord coord", com bonus etc) —
    // por isso reaproveita parseNamedList pra ligar as 4 caixas por nick.

    // Junta coordenadas repetidas numa linha só com "xN" (ex: 3x "497|629" vira "497|629 x3"),
    // capado em 5 por linha (6+ vira "x5" + "x1" etc) — mesma ideia do groupCapped, mas só por coordenada
    // (aqui já é tudo de UM jogador só, não precisa separar por remetente).
    function groupCoordCounts(coords, capPerLine) {
        const counts = {};
        const order = [];
        coords.forEach(function (c) {
            if (!(c in counts)) { counts[c] = 0; order.push(c); }
            counts[c]++;
        });
        const lines = [];
        order.forEach(function (c) {
            let remaining = counts[c];
            while (remaining > 0) {
                const take = Math.min(capPerLine, remaining);
                lines.push(c + (take > 1 ? " x" + take : ""));
                remaining -= take;
            }
        });
        return lines;
    }

    // Mensagem individual: mesma estrutura de seções/spoiler do modelo padrão, mas só com as
    // coordenadas de UM jogador em cada campo (sem repetir o nome, já que a mensagem é dele).
    function buildIndividualMessage(player, dateStr, timeStr, data) {
        const ntLines = groupCoordCounts(data.nt, 5);
        const fakeLines = groupCoordCounts(data.fakes, 5);
        const fullLines = groupCoordCounts(data.fulls, 5);
        const semiLines = groupCoordCounts(data.semis, 5);
        const bonusLines = groupCoordCounts(data.bonus, 5);

        // sempre manda as quatro seções, mesmo vazias (spoiler em branco) — assim quem lê sabe que
        // realmente não tem alvo daquele tipo, em vez de ficar em dúvida se esqueceram de colocar.
        let msg = "⚔️ OPERAÇÃO — " + (dateStr || "(defina a data)") + " — " + player + " ⚔️\n\n" +
            "🕛 Horário de impacto: " + (timeStr || "(defina o horário)") + "\n";

        msg += "\n🎯 SEU(S) NT\n\n[spoiler]\n" + (ntLines.length ? ntLines.join("\n") : "(sem alvo NT)") + "\n[/spoiler]\n";

        msg += "\n🎭 SEUS FAKES COORDENADOS\n\n[spoiler]\n" + (fakeLines.length ? fakeLines.join("\n") : "(sem fake coordenado)") + "\n[/spoiler]\n";

        msg += "\n⚔️ SEUS FULLS E SEMI-FULLS\n\n[spoiler]\n";
        if (fullLines.length || semiLines.length) {
            if (fullLines.length) msg += "FULLS\n\n" + fullLines.join("\n") + "\n";
            if (fullLines.length && semiLines.length) msg += "\n";
            if (semiLines.length) msg += "SEMI-FULLS\n\n" + semiLines.join("\n") + "\n";
        } else {
            msg += "(sem full/semi-full)\n";
        }
        msg += "[/spoiler]\n";

        msg += "\n🎁 SEUS BÔNUS\n\n[spoiler]\n" + (bonusLines.length ? bonusLines.join("\n") : "(sem bônus)") + "\n[/spoiler]\n";
        msg += "\n📌 Você é responsável pela sua própria noblagem: encaixe certinho os apoios colados e envie com anti-snipe.\n" +
            "Se não tiver tropa suficiente pro apoio, fale com algum amigo da tribo pra coordenar com você.\n\n" +
            "❗ Qualquer dúvida, NÃO me procure. Boa OP!";
        return msg;
    }

    // ---------------- link do nome pro perfil do jogador (screen=info_player) ----------------
    // Busca o /map/player.txt do próprio jogo uma vez (id,nome,tribo,aldeias,pontos,rank) e monta um
    // mapa nome(minúsculo) -> id, pra poder linkar o nome de cada MP direto pro perfil dele. Nomes que
    // não baterem exatamente com o nome real no jogo (typo, apelido diferente) ficam sem link mesmo.
    let playerIdMap = null;
    function ensurePlayerIdMap() {
        if (playerIdMap) return Promise.resolve(playerIdMap);
        return fetch("/map/player.txt").then(function (r) { return r.text(); }).then(function (text) {
            const map = {};
            text.split("\n").forEach(function (line) {
                line = line.trim();
                if (!line) return;
                const cols = line.split(",");
                if (cols.length < 2) return;
                const id = cols[0];
                let name = cols[1] || "";
                try { name = decodeURIComponent(name.replace(/\+/g, " ")); } catch (e) { /* mantém como veio */ }
                map[name.toLowerCase()] = id;
            });
            playerIdMap = map;
            return map;
        }).catch(function () {
            playerIdMap = {};
            return playerIdMap;
        });
    }

    // linha compacta por jogador: nome (clicável -> perfil, quando reconhecido) + botão copiar + botão
    // abrir (mostra/esconde o texto da MP). Depois de copiar, a linha fica marcada com ✅ (fica marcada
    // até gerar de novo), pra dar pra ver de cara quem já foi copiado sem precisar rolar a tela toda.
    function messageRowHtml(title, text, playerId) {
        // usa <span> com data-profile-url (nunca <a>) e abre com window.open() no clique — o próprio
        // jogo costuma interceptar clique em links <a> pra navegar "por dentro" da mesma aba, o que
        // destruía o painel e perdia a operação inteira que tava sendo montada. Span comum não é pego
        // por esse tipo de interceptação, então garante que sempre abre numa aba nova de verdade.
        const nameHtml = playerId
            ? '<span class="jjopg-mp-ind-name" data-profile-url="/game.php?screen=info_player&id=' + playerId + '" style="flex:1;color:#eee;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-decoration:underline;text-decoration-color:' + gold + ';cursor:pointer;">👤 ' + title + '</span>'
            : '<span style="flex:1;color:#eee;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">👤 ' + title + '</span>';
        let h = '<div class="jjopg-mp-ind-item" style="margin-bottom:6px;">';
        h += '<div class="jjopg-mp-ind-row" style="display:flex;align-items:center;gap:6px;padding:7px 9px;border:1px solid rgba(216,170,69,.25);border-radius:8px;background:#111318;">';
        h += '<span class="jjopg-mp-ind-check" style="width:16px;text-align:center;flex-shrink:0;"></span>';
        h += nameHtml;
        h += '<button class="jjopg-mp-ind-copy" style="padding:6px 10px;background:' + gold + ';color:#111;font-weight:800;border:none;border-radius:6px;cursor:pointer;flex-shrink:0;">📋 Copiar</button>';
        h += '<button class="jjopg-mp-ind-open" style="padding:6px 10px;background:#222;color:' + gold + ';font-weight:700;border:1px solid ' + gold + ';border-radius:6px;cursor:pointer;flex-shrink:0;">👁️ Abrir</button>';
        h += '</div>';
        h += '<textarea class="jjopg-mp-ind-text" readonly style="display:none;width:100%;box-sizing:border-box;height:160px;padding:6px;margin-top:4px;background:#0d0f12;color:#eee;border:1px solid rgba(216,170,69,.3);border-radius:8px;font-family:monospace;font-size:10px;white-space:pre-wrap;">' + text + '</textarea>';
        h += '</div>';
        return h;
    }

    function wireIndividualMessageRows(box) {
        box.querySelectorAll(".jjopg-mp-ind-item").forEach(function (item) {
            const row = item.querySelector(".jjopg-mp-ind-row");
            const check = item.querySelector(".jjopg-mp-ind-check");
            const copyBtn = item.querySelector(".jjopg-mp-ind-copy");
            const openBtn = item.querySelector(".jjopg-mp-ind-open");
            const textarea = item.querySelector(".jjopg-mp-ind-text");
            const nameEl = item.querySelector(".jjopg-mp-ind-name");

            if (nameEl) {
                nameEl.onclick = function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    if (e.stopImmediatePropagation) e.stopImmediatePropagation();
                    window.open(nameEl.getAttribute("data-profile-url"), "_blank", "noopener");
                };
            }

            openBtn.onclick = function () {
                const isOpen = textarea.style.display !== "none";
                textarea.style.display = isOpen ? "none" : "block";
                openBtn.textContent = isOpen ? "👁️ Abrir" : "🙈 Fechar";
            };

            copyBtn.onclick = function () {
                navigator.clipboard.writeText(textarea.value).then(function () {
                    check.textContent = "✅";
                    row.style.background = "rgba(80,200,120,.14)";
                    row.style.borderColor = "rgba(80,200,120,.55)";
                }).catch(function () { prompt("Copie manualmente:", textarea.value); });
            };
        });
    }

    document.getElementById("jjopg-genmp-ind").onclick = function () {
        const status = document.getElementById("jjopg-mp-ind-status");
        const box = document.getElementById("jjopg-mp-ind-results");
        box.innerHTML = "";
        status.textContent = "Gerando...";

        const dateStr = document.getElementById("jjopg-op-date").value.trim();
        const timeStr = document.getElementById("jjopg-op-time").value.trim();

        const ntEntries = parseNamedList(document.getElementById("jjopg-mp-nt").value);
        const fakeEntries = parseNamedList(document.getElementById("jjopg-mp-fakes").value);
        const fullEntries = parseNamedList(document.getElementById("jjopg-mp-fulls").value);
        const semiEntries = parseNamedList(document.getElementById("jjopg-mp-semis").value);
        const bonusEntries = parseNamedList(document.getElementById("jjopg-mp-bonus").value);

        const playersSet = {};
        [ntEntries, fakeEntries, fullEntries, semiEntries, bonusEntries].forEach(function (list) {
            list.forEach(function (e) { if (e.name && e.name !== "?") playersSet[e.name] = true; });
        });
        const players = Object.keys(playersSet);
        if (!players.length) { status.textContent = "Não encontrei nenhum nick reconhecível nas 4 caixas acima (formato: Nome:N - coord coord ...)."; return; }

        function coordsOf(list, name) { return list.filter(function (e) { return e.name === name; }).map(function (e) { return e.coord; }); }

        // busca o mapa nome->id do jogo (uma vez só, fica em cache) pra poder linkar o nome ao perfil
        ensurePlayerIdMap().then(function (idMap) {
            let html = "";
            let linked = 0;
            players.sort().forEach(function (p) {
                const data = {
                    nt: coordsOf(ntEntries, p),
                    fakes: coordsOf(fakeEntries, p),
                    fulls: coordsOf(fullEntries, p),
                    semis: coordsOf(semiEntries, p),
                    bonus: coordsOf(bonusEntries, p)
                };
                const pid = idMap[p.toLowerCase()];
                if (pid) linked++;
                html += messageRowHtml(p, buildIndividualMessage(p, dateStr, timeStr, data), pid);
            });
            box.innerHTML = html;
            wireIndividualMessageRows(box);
            status.textContent = players.length + " mensagem(ns) individual(is) gerada(s)." +
                (linked ? " " + linked + " nome(s) linkado(s) pro perfil (clique no nome pra abrir)." : " Nenhum nome bateu com jogador real do mundo pra linkar (confira a grafia).");
        });
    };

    // ================= SEÇÃO 8: MAPA MUNDIAL (com diplomacia da tribo + alvos coloridos) =================
    // Painel próprio em canvas, independente da tela do jogo estar aberta no mapa: baixa os dados direto de
    // /map/village.txt e /map/player.txt, e a diplomacia da tribo de screen=ally&mode=contracts (aliados,
    // PNA, inimigos). Por cima dos pontos de diplomacia, desenha os alvos das caixas de NT (amarelo),
    // FAKES (branco) e BÔNUS (verde claro) da Etapa 4, com tooltip do nome ao passar o mouse.
    const MAPCOLOR_ME = "#f0c65d";
    const MAPCOLOR_TRIBE = "#1a3a8f";
    const MAPCOLOR_ALLY = "#5bc0f8";
    const MAPCOLOR_PNA = "#9b5bf8";
    const MAPCOLOR_ENEMY = "#e04b4b";
    const MAPCOLOR_OTHER = "#3a3a3a";
    const MAPCOLOR_NT = "#ffe93b";
    const MAPCOLOR_FAKE = "#ffffff";
    const MAPCOLOR_BONUS = "#8ef58e";

    function buildMapTargets() {
        const seen = {};
        const out = [];
        function addAll(text, kind) {
            parseNamedList(text).forEach(function (p) {
                const key = kind + "|" + p.coord;
                if (seen[key]) return;
                seen[key] = true;
                out.push({ name: p.name, coord: p.coord, x: p.x, y: p.y, kind: kind });
            });
        }
        addAll(document.getElementById("jjopg-mp-nt").value, "nt");
        addAll(document.getElementById("jjopg-mp-fakes").value, "fake");
        addAll(document.getElementById("jjopg-mp-bonus").value, "bonus");
        return out;
    }

    function openWorldMap() {
        const old = document.getElementById("jj-world-map");
        if (old) old.remove();

        const mapTargets = buildMapTargets();

        const panel = document.createElement("div");
        panel.id = "jj-world-map";
        panel.style.cssText =
            "position:fixed;inset:0;z-index:999999;background:#08090c;" +
            "font-family:-apple-system,BlinkMacSystemFont,Verdana,Arial;color:#eee;" +
            "display:flex;flex-direction:column;";

        panel.innerHTML =
            '<div style="display:flex;align-items:center;justify-content:space-between;padding:8px 10px;background:linear-gradient(135deg,#191b1f,#090a0c);border-bottom:1px solid rgba(216,170,69,.4);">' +
                '<div style="color:#f0c65d;font-size:13px;font-weight:800;">🗺️ MAPA MUNDIAL — PLANO DA OP</div>' +
                '<span id="jjwm-x" style="width:26px;height:26px;display:flex;align-items:center;justify-content:center;color:#ddd;font-size:14px;border:1px solid rgba(216,170,69,.4);border-radius:6px;background:#111318;cursor:pointer;">✕</span>' +
            '</div>' +
            '<div id="jjwm-status" style="padding:6px 10px;color:#999;font-size:9px;">Carregando dados...</div>' +
            '<div style="position:relative;flex:1;overflow:hidden;">' +
                '<canvas id="jjwm-canvas" style="display:block;width:100%;height:100%;touch-action:none;"></canvas>' +
                '<div id="jjwm-tooltip" style="position:absolute;display:none;pointer-events:none;background:#000;color:#ffe066;font-size:10px;font-weight:800;padding:2px 6px;border-radius:4px;border:1px solid #d8aa45;white-space:nowrap;z-index:2;"></div>' +
                '<div style="position:absolute;right:10px;bottom:70px;display:flex;flex-direction:column;gap:6px;">' +
                    '<button id="jjwm-zoom-in" style="width:36px;height:36px;background:#111318;color:#d8aa45;border:1px solid rgba(216,170,69,.5);border-radius:8px;font-size:16px;font-weight:800;">+</button>' +
                    '<button id="jjwm-zoom-out" style="width:36px;height:36px;background:#111318;color:#d8aa45;border:1px solid rgba(216,170,69,.5);border-radius:8px;font-size:16px;font-weight:800;">−</button>' +
                    '<button id="jjwm-reset" style="width:36px;height:36px;background:#111318;color:#ccc;border:1px solid rgba(216,170,69,.5);border-radius:8px;font-size:11px;">⟳</button>' +
                '</div>' +
                '<div style="position:absolute;left:10px;bottom:10px;padding:6px 8px;background:rgba(10,11,14,.85);border:1px solid rgba(216,170,69,.3);border-radius:8px;font-size:8px;line-height:14px;">' +
                    '<div><span style="display:inline-block;width:8px;height:8px;background:' + MAPCOLOR_ME + ';border-radius:2px;margin-right:4px;"></span>Eu</div>' +
                    '<div><span style="display:inline-block;width:8px;height:8px;background:' + MAPCOLOR_TRIBE + ';border-radius:2px;margin-right:4px;"></span>Minha tribo</div>' +
                    '<div><span style="display:inline-block;width:8px;height:8px;background:' + MAPCOLOR_ALLY + ';border-radius:2px;margin-right:4px;"></span>Aliada</div>' +
                    '<div><span style="display:inline-block;width:8px;height:8px;background:' + MAPCOLOR_PNA + ';border-radius:2px;margin-right:4px;"></span>PNA</div>' +
                    '<div><span style="display:inline-block;width:8px;height:8px;background:' + MAPCOLOR_ENEMY + ';border-radius:2px;margin-right:4px;"></span>Inimiga</div>' +
                    '<div><span style="display:inline-block;width:8px;height:8px;background:' + MAPCOLOR_OTHER + ';border-radius:2px;margin-right:4px;"></span>Outras</div>' +
                    '<div style="margin-top:4px;border-top:1px solid rgba(216,170,69,.3);padding-top:4px;"><span style="display:inline-block;width:9px;height:9px;background:' + MAPCOLOR_NT + ';border-radius:2px;margin-right:4px;border:1px solid #000;"></span>🎯 Alvo NT</div>' +
                    '<div><span style="display:inline-block;width:9px;height:9px;background:' + MAPCOLOR_FAKE + ';border-radius:2px;margin-right:4px;border:1px solid #000;"></span>🎭 Fake</div>' +
                    '<div><span style="display:inline-block;width:9px;height:9px;background:' + MAPCOLOR_BONUS + ';border-radius:2px;margin-right:4px;border:1px solid #000;"></span>🎁 Bônus</div>' +
                '</div>' +
            '</div>';

        document.body.appendChild(panel);
        document.getElementById("jjwm-x").onclick = function () { panel.remove(); };

        const canvas = document.getElementById("jjwm-canvas");
        const ctx = canvas.getContext("2d");
        const statusEl = document.getElementById("jjwm-status");
        const tooltip = document.getElementById("jjwm-tooltip");

        const dpr = window.devicePixelRatio || 1;
        function resizeCanvas() {
            const rect = canvas.getBoundingClientRect();
            canvas.width = rect.width * dpr;
            canvas.height = rect.height * dpr;
        }
        resizeCanvas();

        const state = {
            minX: 0, maxX: 999, minY: 0, maxY: 999,
            scale: 1, offsetX: 0, offsetY: 0,
            mine: [], tribe: [], ally: [], pna: [], enemy: [], other: [],
            targets: mapTargets
        };

        function fitToView() {
            const w = canvas.width, h = canvas.height;
            const worldW = Math.max(1, state.maxX - state.minX);
            const worldH = Math.max(1, state.maxY - state.minY);
            const scaleX = w / worldW;
            const scaleY = h / worldH;
            state.scale = Math.min(scaleX, scaleY) * 0.95;
            state.offsetX = (w - worldW * state.scale) / 2;
            state.offsetY = (h - worldH * state.scale) / 2;
        }

        function worldToScreen(x, y) {
            return [
                (x - state.minX) * state.scale + state.offsetX,
                (y - state.minY) * state.scale + state.offsetY
            ];
        }

        let pendingDraw = false;
        function draw() {
            if (pendingDraw) return;
            pendingDraw = true;
            requestAnimationFrame(function () {
                pendingDraw = false;
                ctx.setTransform(1, 0, 0, 1, 0, 0);
                ctx.fillStyle = "#08090c";
                ctx.fillRect(0, 0, canvas.width, canvas.height);

                // todo mundo usa EXATAMENTE o mesmo tamanho — uma aldeia = um quadradinho de 1 tile de
                // largura na escala atual (nem mais nem menos). Tamanhos diferentes por grupo faziam os
                // quadrados "importantes" (tribo/eu/alvo) ficarem maiores que 1 tile e invadirem o espaço
                // das aldeias vizinhas, dando a impressão de sobreposição/desalinhamento com o mapa real.
                const dot = Math.max(1, state.scale);

                ctx.fillStyle = MAPCOLOR_OTHER;
                state.other.forEach(function (v) {
                    const p = worldToScreen(v.x, v.y);
                    if (p[0] < -5 || p[0] > canvas.width + 5 || p[1] < -5 || p[1] > canvas.height + 5) return;
                    ctx.fillRect(p[0] - dot / 2, p[1] - dot / 2, dot, dot);
                });

                function drawGroup(list, color) {
                    ctx.fillStyle = color;
                    list.forEach(function (v) {
                        const p = worldToScreen(v.x, v.y);
                        if (p[0] < -5 || p[0] > canvas.width + 5 || p[1] < -5 || p[1] > canvas.height + 5) return;
                        ctx.fillRect(p[0] - dot / 2, p[1] - dot / 2, dot, dot);
                    });
                }
                drawGroup(state.pna, MAPCOLOR_PNA);
                drawGroup(state.ally, MAPCOLOR_ALLY);
                drawGroup(state.enemy, MAPCOLOR_ENEMY);

                ctx.fillStyle = MAPCOLOR_TRIBE;
                state.tribe.forEach(function (v) {
                    const p = worldToScreen(v.x, v.y);
                    ctx.fillRect(p[0] - dot / 2, p[1] - dot / 2, dot, dot);
                });

                ctx.fillStyle = MAPCOLOR_ME;
                state.mine.forEach(function (v) {
                    const p = worldToScreen(v.x, v.y);
                    ctx.fillRect(p[0] - dot / 2, p[1] - dot / 2, dot, dot);
                });

                // alvos da OP por cima de tudo: mesmo tamanho exato de 1 tile, só pinta por cima do
                // quadradinho que já existia ali, sem transbordar pras aldeias vizinhas.
                state.targets.forEach(function (t) {
                    const p = worldToScreen(t.x, t.y);
                    if (p[0] < -10 || p[0] > canvas.width + 10 || p[1] < -10 || p[1] > canvas.height + 10) return;
                    ctx.fillStyle = t.kind === "fake" ? MAPCOLOR_FAKE : (t.kind === "bonus" ? MAPCOLOR_BONUS : MAPCOLOR_NT);
                    ctx.fillRect(p[0] - dot / 2, p[1] - dot / 2, dot, dot);
                });
            });
        }

        // ---- tooltip com o nome do alvo ao passar o mouse ----
        canvas.addEventListener("mousemove", function (e) {
            const rect = canvas.getBoundingClientRect();
            const mx = (e.clientX - rect.left) * dpr;
            const my = (e.clientY - rect.top) * dpr;
            let found = null;
            let bestDist = Infinity;
            state.targets.forEach(function (t) {
                const p = worldToScreen(t.x, t.y);
                const d = Math.hypot(p[0] - mx, p[1] - my);
                const radius = Math.max(8, state.scale * 3);
                if (d <= radius && d < bestDist) { bestDist = d; found = t; }
            });
            if (found) {
                tooltip.textContent = (found.kind === "fake" ? "🎭 " : found.kind === "bonus" ? "🎁 " : "🎯 ") + found.name + " — " + found.coord;
                tooltip.style.display = "block";
                tooltip.style.left = (e.clientX - rect.left + 14) + "px";
                tooltip.style.top = (e.clientY - rect.top - 10) + "px";
                canvas.style.cursor = "pointer";
            } else {
                tooltip.style.display = "none";
                canvas.style.cursor = dragging ? "grabbing" : "grab";
            }
        });
        canvas.addEventListener("mouseleave", function () { tooltip.style.display = "none"; });

        // ---- carregar dados (mapa do mundo + diplomacia da tribo) ----
        let myId = null;
        try { myId = window.game_data && game_data.player && String(game_data.player.id); } catch (e) { /* ignore */ }

        function fetchText(url) { return fetch(url).then(function (r) { return r.text(); }); }

        function fetchDiplomacy() {
            let villageId = "0";
            try { if (window.game_data && game_data.village) villageId = game_data.village.id; } catch (e) { /* ignore */ }
            const url = "/game.php?village=" + villageId + "&screen=ally&mode=contracts";

            return fetch(url, { credentials: "same-origin" }).then(function (res) { return res.text(); }).then(function (html) {
                const doc = new DOMParser().parseFromString(html, "text/html");
                const allyIds = [], pnaIds = [], enemyIds = [];
                let currentSection = null;

                const allNodes = doc.body.querySelectorAll("*");
                allNodes.forEach(function (el) {
                    let ownText = "";
                    for (let c = 0; c < el.childNodes.length; c++) {
                        if (el.childNodes[c].nodeType === 3) ownText += el.childNodes[c].textContent;
                    }
                    ownText = ownText.trim();

                    if (ownText && /^aliad/i.test(ownText)) { currentSection = "ally"; return; }
                    if (ownText && /pactos? de n[aã]o.?agress/i.test(ownText)) { currentSection = "pna"; return; }
                    if (ownText && /^inimig/i.test(ownText)) { currentSection = "enemy"; return; }

                    if (el.tagName === "A" && el.textContent.trim() === "Terminar") {
                        const href = el.getAttribute("href") || "";
                        const m = href.match(/[?&]id=(\d+)/);
                        if (!m || !currentSection) return;
                        const id = m[1];
                        if (currentSection === "ally") allyIds.push(id);
                        else if (currentSection === "pna") pnaIds.push(id);
                        else if (currentSection === "enemy") enemyIds.push(id);
                    }
                });

                return { allyIds: allyIds, pnaIds: pnaIds, enemyIds: enemyIds };
            });
        }

        if (!myId) {
            statusEl.textContent = "⚠️ Não consegui identificar seu jogador (game_data.player.id ausente).";
        } else {
            statusEl.textContent = "🔎 Lendo diplomacia da tribo...";

            fetchDiplomacy().then(function (diplo) {
                fetchText("/map/player.txt").then(function (playerText) {
                    const lines = playerText.split("\n");
                    let myAllyId = null;
                    const allyOf = {};
                    for (let i = 0; i < lines.length; i++) {
                        const line = lines[i].trim();
                        if (!line) continue;
                        const cols = line.split(",");
                        if (cols.length < 3) continue;
                        allyOf[cols[0]] = cols[2];
                        if (cols[0] === myId) myAllyId = cols[2];
                    }

                    const allySet = {}; diplo.allyIds.forEach(function (id) { allySet[id] = true; });
                    const pnaSet = {}; diplo.pnaIds.forEach(function (id) { pnaSet[id] = true; });
                    const enemySet = {}; diplo.enemyIds.forEach(function (id) { enemySet[id] = true; });

                    statusEl.textContent = "🔎 Baixando aldeias do mundo...";

                    fetchText("/map/village.txt").then(function (villageText) {
                        const vLines = villageText.split("\n");
                        const mine = [], tribe = [], ally = [], pna = [], enemy = [], other = [];
                        let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;

                        for (let j = 0; j < vLines.length; j++) {
                            const vline = vLines[j].trim();
                            if (!vline) continue;
                            const vcols = vline.split(",");
                            if (vcols.length < 5) continue;
                            const x = parseInt(vcols[2], 10);
                            const y = parseInt(vcols[3], 10);
                            if (isNaN(x) || isNaN(y)) continue;
                            const pid = vcols[4];
                            const pAllyId = pid ? allyOf[pid] : null;

                            if (x < minX) minX = x;
                            if (x > maxX) maxX = x;
                            if (y < minY) minY = y;
                            if (y > maxY) maxY = y;

                            if (pid === myId) {
                                mine.push({ x: x, y: y });
                            } else if (pAllyId && myAllyId && pAllyId === myAllyId) {
                                tribe.push({ x: x, y: y });
                            } else if (pAllyId && enemySet[pAllyId]) {
                                enemy.push({ x: x, y: y });
                            } else if (pAllyId && allySet[pAllyId]) {
                                ally.push({ x: x, y: y });
                            } else if (pAllyId && pnaSet[pAllyId]) {
                                pna.push({ x: x, y: y });
                            } else {
                                other.push({ x: x, y: y });
                            }
                        }

                        state.minX = minX; state.maxX = maxX; state.minY = minY; state.maxY = maxY;
                        state.mine = mine; state.tribe = tribe; state.ally = ally; state.pna = pna; state.enemy = enemy; state.other = other;

                        fitToView();
                        draw();

                        statusEl.textContent = "✅ " + (mine.length + tribe.length + ally.length + pna.length + enemy.length + other.length) + " aldeias — " +
                            mine.length + " minhas, " + tribe.length + " da tribo, " + ally.length + " aliadas, " + pna.length + " PNA, " + enemy.length + " inimigas. " +
                            state.targets.length + " alvo(s) da OP marcados (🎯 " + state.targets.filter(function (t) { return t.kind === "nt"; }).length +
                            " NT, 🎭 " + state.targets.filter(function (t) { return t.kind === "fake"; }).length +
                            " fake, 🎁 " + state.targets.filter(function (t) { return t.kind === "bonus"; }).length + " bônus).";
                    }).catch(function (e) { statusEl.textContent = "❌ Erro ao baixar village.txt: " + e.message; });
                }).catch(function (e) { statusEl.textContent = "❌ Erro ao baixar player.txt: " + e.message; });
            }).catch(function (e) { statusEl.textContent = "❌ Erro ao ler diplomacia: " + e.message; });
        }

        // ---- zoom / pan ----
        document.getElementById("jjwm-zoom-in").onclick = function () { zoomAt(canvas.width / 2, canvas.height / 2, 1.4); };
        document.getElementById("jjwm-zoom-out").onclick = function () { zoomAt(canvas.width / 2, canvas.height / 2, 1 / 1.4); };
        document.getElementById("jjwm-reset").onclick = function () { fitToView(); draw(); };

        function zoomAt(sx, sy, factor) {
            const wx = (sx - state.offsetX) / state.scale;
            const wy = (sy - state.offsetY) / state.scale;
            state.scale *= factor;
            state.offsetX = sx - wx * state.scale;
            state.offsetY = sy - wy * state.scale;
            draw();
        }

        let dragging = false, lastX = 0, lastY = 0;
        let pinchDist = null;

        function getTouchDist(touches) {
            const dx = touches[0].clientX - touches[1].clientX;
            const dy = touches[0].clientY - touches[1].clientY;
            return Math.sqrt(dx * dx + dy * dy);
        }

        canvas.addEventListener("touchstart", function (e) {
            if (e.touches.length === 1) {
                dragging = true;
                lastX = e.touches[0].clientX;
                lastY = e.touches[0].clientY;
            } else if (e.touches.length === 2) {
                dragging = false;
                pinchDist = getTouchDist(e.touches);
            }
        }, { passive: true });

        canvas.addEventListener("touchmove", function (e) {
            const rect = canvas.getBoundingClientRect();
            if (e.touches.length === 1 && dragging) {
                const dx = (e.touches[0].clientX - lastX) * dpr;
                const dy = (e.touches[0].clientY - lastY) * dpr;
                state.offsetX += dx;
                state.offsetY += dy;
                lastX = e.touches[0].clientX;
                lastY = e.touches[0].clientY;
                draw();
            } else if (e.touches.length === 2 && pinchDist !== null) {
                const newDist = getTouchDist(e.touches);
                const factor = newDist / pinchDist;
                const cx = ((e.touches[0].clientX + e.touches[1].clientX) / 2 - rect.left) * dpr;
                const cy = ((e.touches[0].clientY + e.touches[1].clientY) / 2 - rect.top) * dpr;
                zoomAt(cx, cy, factor);
                pinchDist = newDist;
            }
            if (e.cancelable) e.preventDefault();
        }, { passive: false });

        canvas.addEventListener("touchend", function (e) {
            if (e.touches.length === 0) { dragging = false; pinchDist = null; }
        }, { passive: true });

        canvas.addEventListener("mousedown", function (e) {
            dragging = true; lastX = e.clientX; lastY = e.clientY;
        });
        document.addEventListener("mousemove", function (e) {
            if (!dragging) return;
            state.offsetX += (e.clientX - lastX) * dpr;
            state.offsetY += (e.clientY - lastY) * dpr;
            lastX = e.clientX; lastY = e.clientY;
            draw();
        });
        document.addEventListener("mouseup", function () { dragging = false; });
        canvas.addEventListener("wheel", function (e) {
            e.preventDefault();
            const rect = canvas.getBoundingClientRect();
            const sx = (e.clientX - rect.left) * dpr;
            const sy = (e.clientY - rect.top) * dpr;
            zoomAt(sx, sy, e.deltaY < 0 ? 1.15 : 1 / 1.15);
        }, { passive: false });

        window.addEventListener("resize", function () { resizeCanvas(); draw(); });
    }

    document.getElementById("jjopg-showmap").onclick = function () {
        openWorldMap();
    };
    // ================= SEÇÃO 9: EXPORTAR PLANO =================
    function buildExportText() {
        if (!assignments.length) return null;
        let lines = ["ORIGEM\tALVO\tBÔNUS\tPAPEL\tJOGADOR"];
        assignments.forEach(function (a) {
            if (a.selfSufficient) {
                lines.push(["-", a.target.coord, a.target.bonus ? "SIM" : "", "auto-suficiente", a.target.owner].join("\t"));
                return;
            }
            a.fulls.forEach(function (f) {
                lines.push([f.coord || "-", a.target.coord, a.target.bonus ? "SIM" : "", f.role, f.player].join("\t"));
            });
        });
        return lines.join("\n");
    }
    document.getElementById("jjopg-export-copy").onclick = function () {
        const status = document.getElementById("jjopg-export-status");
        const text = buildExportText();
        if (!text) { status.textContent = "Nada pra exportar ainda — gere a distribuição primeiro."; return; }
        copyText(this, text);
        status.textContent = "Tabela copiada.";
    };
    document.getElementById("jjopg-export-file").onclick = function () {
        const status = document.getElementById("jjopg-export-status");
        const text = buildExportText();
        if (!text) { status.textContent = "Nada pra exportar ainda — gere a distribuição primeiro."; return; }
        const blob = new Blob([text], { type: "text/plain" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = "plano_op_" + Date.now() + ".txt";
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
        status.textContent = "Arquivo baixado.";
    };

    // ---------------- inicialização ----------------
    renderTargets();

})();