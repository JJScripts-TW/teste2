                    : "⚔️ ORDEM DE ATAQUE — FULL DE APOIO\n\nAldeia: " + f.coord + "\nAlvo: " + a.target.coord + "\n\n🕐 Enviar às: " + dep + "\n🎯 Chegada prevista: " + arr + "\n\nEnvie TODAS as tropas ofensivas dessa aldeia para o alvo acima, seguindo exatamente o horário indicado. Confirme quando enviar!"
                );
                html += '<div style="border:1px solid rgba(216,170,69,.2);border-radius:8px;padding:6px 8px;margin-bottom:6px;">';
                html += '<div style="color:' + gold + ';font-weight:700;margin-bottom:4px;">' + (isNT ? "👑 " : "⚔️ ") + f.player + ' (' + f.coord + ')</div>';
                html += '<button class="jjopg-mp-copy" data-text="' + encodeURIComponent(text) + '" style="width:100%;padding:6px;background:#222;color:' + gold + ';font-weight:700;border:1px solid ' + gold + ';border-radius:6px;cursor:pointer;">📋 COPIAR MENSAGEM</button>';
