    // ================= SEÇÃO 5: DISTRIBUIÇÃO POR PROXIMIDADE =================
    document.getElementById("jjopg-distribute").onclick = function () {
        const status = document.getElementById("jjopg-dist-status");
        const box = document.getElementById("jjopg-dist-results");
        box.innerHTML = "";
        const minFulls = Math.max(1, parseInt(document.getElementById("jjopg-minfulls").value, 10) || 1);

        if (!ownFulls.length) { status.textContent = "Importe fulls na Etapa 1 primeiro."; return; }
        if (!targets.length) { status.textContent = "Colete alvos nas Etapas 3/4 primeiro."; return; }

        const pool = ownFulls.slice();
        assignments = [];

        targets.forEach(function (target) {
            const withDist = pool.map(function (f) { return { full: f, d: dist(target, f) }; })
                .sort(function (a, b) { return a.d - b.d; });
            const chosen = withDist.slice(0, minFulls);
            chosen.forEach(function (c) {
                const idx = pool.indexOf(c.full);
                if (idx >= 0) pool.splice(idx, 1);
            });
            if (chosen.length) {
                assignments.push({
                    target: target,
                    fulls: chosen.map(function (c, i) {
                        return { coord: c.full.coord, x: c.full.x, y: c.full.y, player: c.full.player, dist: c.d, role: i === 0 ? "NT (nobre)" : "Full apoio" };
                    })
                });
            }
        });

        const semFull = targets.length - assignments.length;
        status.textContent = "Distribuição gerada para " + assignments.length + " de " + targets.length + " alvo(s)." + (semFull ? " (" + semFull + " sem fulls suficientes)" : "");

        let html = "";
        assignments.forEach(function (a) {
            html += '<div style="border:1px solid rgba(216,170,69,.2);border-radius:8px;padding:6px 8px;margin-bottom:6px;">';
            html += '<div style="color:' + gold + ';font-weight:700;margin-bottom:4px;">🎯 Alvo: ' + a.target.coord + ' (' + a.target.owner + ')</div>';
            a.fulls.forEach(function (f) {
                html += '<div style="padding:2px 0;color:#ccc;">' + (f.role === "NT (nobre)" ? "👑 " : "⚔️ ") + f.coord + ' - ' + f.player + ' <span style="color:#888;">(' + f.dist.toFixed(1) + ' campos, ' + f.role + ')</span></div>';
            });
            html += '</div>';
        });
        box.innerHTML = html;
    };

    // ================= SEÇÃO 6: SINCRONIZAÇÃO DE HORÁRIO =================
    async function fetchWorldConfig() {
        try {
            const xml = await fetchText("/interface.php?func=get_config");
            const doc = new DOMParser().parseFromString(xml, "text/xml");
            const speedEl = doc.querySelector("speed");
            const unitSpeedEl = doc.querySelector("unit_speed");
            worldSpeed = speedEl ? parseFloat(speedEl.textContent) : 1;
            unitSpeedCfg = unitSpeedEl ? parseFloat(unitSpeedEl.textContent) : 1;
        } catch (e) { worldSpeed = 1; unitSpeedCfg = 1; }
    }
    function slowestSpeed(unitsPresent) {
        // unitsPresent: array de chaves de unidade com contagem > 0 nessa full
        let slowest = BASE_SPEED.axe;
        unitsPresent.forEach(function (u) {
            if (BASE_SPEED[u] && BASE_SPEED[u] > slowest) slowest = BASE_SPEED[u];
        });
        return slowest; // min/campo @ velocidade 1
    }
    function parseArrivalInput(str) {
        const now = new Date();
        const m = String(str).trim().match(/^(\d{1,2}):(\d{2})$/);
        if (!m) return null;
        const d = new Date(now);
        d.setHours(parseInt(m[1], 10), parseInt(m[2], 10), 0, 0);
        if (d.getTime() < now.getTime()) d.setDate(d.getDate() + 1);
        return d;
    }
    function fmtTime(d) {
        return d.getHours().toString().padStart(2, "0") + ":" + d.getMinutes().toString().padStart(2, "0") + ":" + d.getSeconds().toString().padStart(2, "0");
    }
    document.getElementById("jjopg-sync").onclick = async function () {
        const status = document.getElementById("jjopg-sync-status");
        const box = document.getElementById("jjopg-sync-results");
        box.innerHTML = "";
        if (!assignments.length) { status.textContent = "Gere a distribuição na Etapa 5 primeiro."; return; }

        status.textContent = "Buscando configuração do mundo...";
        await fetchWorldConfig();

        const arrivalInput = document.getElementById("jjopg-arrival").value.trim();
        let desiredArrival = arrivalInput ? parseArrivalInput(arrivalInput) : null;

        // calcula tempo de viagem de cada full (assume composição mista axe+light+ram -> usa a mais lenta presente)
        assignments.forEach(function (a) {
            const d = dist(a.target, a.target); // placeholder, recalculado abaixo por full
            a.fulls.forEach(function (f) {
                const distFields = dist(a.target, f);
                const unitsPresent = ["axe", "light", "ram"]; // full padrão: assume que pode ter aríete
                const base = slowestSpeed(unitsPresent);
                const minPerField = base / (worldSpeed * unitSpeedCfg);
                const travelMin = distFields * minPerField;
                f.travelMin = travelMin;
            });
        });

        // se não foi definido horário de chegada, usa o full mais lento de todo o plano partindo agora
        if (!desiredArrival) {
            let maxTravel = 0;
            assignments.forEach(function (a) { a.fulls.forEach(function (f) { if (f.travelMin > maxTravel) maxTravel = f.travelMin; }); });
            desiredArrival = new Date(Date.now() + maxTravel * 60000);
        }

        let html = "";
        assignments.forEach(function (a) {
            html += '<div style="border:1px solid rgba(216,170,69,.2);border-radius:8px;padding:6px 8px;margin-bottom:6px;">';
            html += '<div style="color:' + gold + ';font-weight:700;margin-bottom:4px;">🎯 Alvo: ' + a.target.coord + ' — chegada: ' + fmtTime(desiredArrival) + '</div>';
            a.fulls.forEach(function (f) {
                const departure = new Date(desiredArrival.getTime() - f.travelMin * 60000);
                f.departure = departure;
                f.arrival = desiredArrival;
                const late = departure.getTime() < Date.now();
                html += '<div style="padding:2px 0;color:#ccc;">' + (f.role === "NT (nobre)" ? "👑 " : "⚔️ ") + f.coord + ' - ' + f.player +
                    ' <span style="color:' + (late ? "#e77" : "#8c8") + ';">Enviar: ' + fmtTime(departure) + (late ? " (⚠️ já passou!)" : "") + '</span></div>';
            });
            html += '</div>';
        });
        box.innerHTML = html;
        status.textContent = "Sincronização calculada (vel. mundo x" + worldSpeed + ", vel. unidades x" + unitSpeedCfg + "). Valores aproximados — confirme no jogo antes de enviar.";
    };

