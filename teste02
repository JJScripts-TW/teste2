            const parsed = parseFullsListText(document.getElementById("jjopg-fulls-edit").value);
            ownFulls = parsed;
            document.getElementById("jjopg-uselist-status").textContent = "Lista atualizada: " + parsed.length + " aldeia(s) prontas para a distribuição por proximidade.";
        };
    }
    document.getElementById("jjopg-import").onclick = importFulls;

    // ================= SEÇÃO 2: COLAR COORDENADAS =================
    function renderTargets() {
        const box = document.getElementById("jjopg-targets-box");
        if (!box) return;
        if (!targets.length) { box.innerHTML = '<div style="color:#999;">Nenhum alvo adicionado ainda.</div>'; return; }
        const byOwner = {};
        targets.forEach(function (t) { byOwner[t.owner] = (byOwner[t.owner] || 0) + 1; });
