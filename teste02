    function leftoverItemsFrom(remainingPool) {
        const items = [];
        Object.keys(remainingPool).forEach(function (p) {
            const r = remainingPool[p];
            if (r.full > 0 || r.semi > 0) items.push(p + " " + r.full + " F " + r.semi + " S");
        });
        return items;
    }

    function buildAssignmentFieldsHtml(assignmentsList) {
        const fullEntries = [], semiEntries = [];
        const ownerByCoord = {};
        assignmentsList.forEach(function (a) {
            ownerByCoord[a.target.coord] = a.target.owner;
            if (a.selfSufficient) return;
            a.fulls.forEach(function (f) {
                const rec = { player: f.player, target: a.target.coord };
                if (f.type === "SEMI") semiEntries.push(rec); else fullEntries.push(rec);
            });
        });
        const fullItems = groupCapped(fullEntries, 5, ownerByCoord);
        const semiItems = groupCapped(semiEntries, 5, ownerByCoord);
        const bonusItems = assignmentsList.filter(function (a) { return a.target.bonus; })
            .map(function (a) { return a.target.coord + " - " + (a.target.owner || "?"); });
        let html = "";
        html += fieldHtml("⚔️ Alvos Fulls", fullItems, "#7fb8e0");
        html += fieldHtml("🌓 Alvos Semi-fulls", semiItems, "#b08cd6");
        html += fieldHtml("🎁 Alvos Bônus", bonusItems, "#e0b84a");
        return html;
    }

    // ---------------- Rodada 1 ----------------
    document.getElementById("jjopg-distribute").onclick = function () {
        const status = document.getElementById("jjopg-dist-status");
        const box = document.getElementById("jjopg-dist-results");
        box.innerHTML = "";
        const minFulls = Math.max(1, parseInt(document.getElementById("jjopg-minfulls").value, 10) || 1);
        const skipBonus = document.getElementById("jjopg-skip-bonus").checked;

        const targetsParsed = parseNamedList(document.getElementById("jjopg-dist-targets-box").value);
        const poolParsed = parsePlayerQuota(document.getElementById("jjopg-dist-pool-box").value, knownPlayerNames());

        if (!targetsParsed.length) { status.textContent = "Preencha a caixinha de alvos (Nome:N coord coord ...)."; return; }
        if (!poolParsed.length) { status.textContent = "Preencha a caixinha de fulls/semis disponíveis (Nome F S)."; return; }

        const remaining = {};
        const playerOrder = [];
        poolParsed.forEach(function (q) {
            remaining[q.player] = { full: q.fullQuota, semi: q.semiQuota };
            playerOrder.push(q.player);
        });

        const result = allocateTargets(targetsParsed, remaining, playerOrder, minFulls, skipBonus);
        if (!result.assignmentsList.length) { status.textContent = "Todos os alvos são bônus e estão ocultos — desmarque a opção ou adicione alvos normais."; return; }
        assignments = result.assignmentsList;
        lastRemainingPool = remaining;

        const incompletos = assignments.filter(function (a) { return !a.selfSufficient && a.fulls.length < a.needWanted; }).length;
        status.textContent = "Rodada 1: distribuição gerada para " + assignments.length + " alvo(s)." +
            (incompletos ? " (" + incompletos + " sem apoio suficiente na pool)" : "") +
            (result.skippedCount ? " (" + result.skippedCount + " alvo(s) bônus ocultado(s))" : "");

        const leftoverItems = leftoverItemsFrom(lastRemainingPool);
        let html = buildAssignmentFieldsHtml(assignments);
        html += fieldHtml("♻️ Sobra da pool (não usada nesta rodada)", leftoverItems, "#8c8");
        html += '<div style="color:#888;margin-top:-2px;margin-bottom:8px;">Essa sobra já alimenta automaticamente a caixinha de "3️⃣.2 Distribuir alvos SEMI-FULL" logo abaixo.</div>';
        box.innerHTML = html;
        wireFieldCopyButtons(box);
    };

    // extrai só as coordenadas de um texto (ignora nome/número), sem duplicar a mesma coordenada 2x
    function extractPlainCoords(text) {
        const re = /\d{1,3}\|\d{1,3}/g;
        const seen = {};
        const out = [];
        let m;
        while ((m = re.exec(text)) !== null) {
            if (seen[m[0]]) continue;
            seen[m[0]] = true;
            const pc = parseCoord(m[0]);
            if (pc) out.push({ coord: pc.coord, x: pc.x, y: pc.y });
        }
        return out;
    }

    // espalha TODO o pool disponível igualmente entre as coordenadas (round-robin): 1 apoio pra cada
    // primeiro, se sobrar dá o 2º pra cada, etc. Fulls são distribuídos antes dos semis.
    function proportionalAllocate(targetCoords, remaining, playerOrder) {
        const queue = [];
        playerOrder.forEach(function (p) {
            for (let i = 0; i < remaining[p].full; i++) queue.push({ player: p, type: "FULL", role: "Full apoio" });
        });
        playerOrder.forEach(function (p) {
            for (let i = 0; i < remaining[p].semi; i++) queue.push({ player: p, type: "SEMI", role: "Semi apoio" });
        });
        const n = targetCoords.length;
        const perTarget = targetCoords.map(function () { return []; });
        queue.forEach(function (u, i) {
            perTarget[i % n].push(u);
            if (u.type === "FULL") remaining[u.player].full--; else remaining[u.player].semi--;
        });
        return targetCoords.map(function (c, idx) {
            return { target: { coord: c.coord, x: c.x, y: c.y, owner: null, bonus: false }, fulls: perTarget[idx], selfSufficient: false };
        });
    }

    // ---------------- Rodada 2 (caixinha própria e independente — distribuição PROPORCIONAL) ----------------
    document.getElementById("jjopg-distribute-2").onclick = function () {
        const status = document.getElementById("jjopg-dist-status-2");
        const box = document.getElementById("jjopg-dist-results-2");
        box.innerHTML = "";

        const targetCoords2 = extractPlainCoords(document.getElementById("jjopg-dist-targets-box-2").value);
        if (!targetCoords2.length) { status.textContent = "Preencha a caixinha de coordenadas desta rodada."; return; }

        const quota2 = parsePlayerQuota(document.getElementById("jjopg-dist-pool-box-2").value, knownPlayerNames());
        if (!quota2.length) { status.textContent = "Preencha a caixinha de pool desta rodada (formato Nome F S — ex: Arken 0 F 10 S)."; return; }

        const remaining2 = {};
        const playerOrder2 = [];
        quota2.forEach(function (q) {
            remaining2[q.player] = { full: q.fullQuota, semi: q.semiQuota };
            playerOrder2.push(q.player);
        });

        const totalFull2 = playerOrder2.reduce(function (s, p) { return s + remaining2[p].full; }, 0);
        const totalSemi2 = playerOrder2.reduce(function (s, p) { return s + remaining2[p].semi; }, 0);
        if (totalFull2 + totalSemi2 <= 0) { status.textContent = "A pool desta rodada está zerada (0 F, 0 S) — não há nada pra distribuir."; return; }

        const assignments2 = proportionalAllocate(targetCoords2, remaining2, playerOrder2);
        const semAssignments2 = assignments2.filter(function (a) { return a.fulls.length === 0; }).length;
        const base = Math.floor((totalFull2 + totalSemi2) / targetCoords2.length);

        status.textContent = "Rodada 2: " + (totalFull2 + totalSemi2) + " apoio(s) (" + totalFull2 + " full, " + totalSemi2 + " semi) espalhados entre " + targetCoords2.length + " coordenada(s) — " +
            (base >= 1 ? base + " apoio(s) por coordenada (alguns ganham +1 pra fechar a conta)" : "não dá 1 apoio pra cada, algumas coordenadas ficam sem") +
            (semAssignments2 ? " (" + semAssignments2 + " coordenada(s) sem nenhum apoio)" : "") + ".";

        const leftoverItems2 = leftoverItemsFrom(remaining2);
        let html2 = buildAssignmentFieldsHtml(assignments2);
        html2 += fieldHtml("♻️ Sobra desta rodada", leftoverItems2, "#8c8");
        box.innerHTML = html2;
        wireFieldCopyButtons(box);
    };

    // ================= SEÇÃO 7: GERADOR DE MENSAGEM DA OPERAÇÃO =================
    // MODELO PADRÃO FIXO — só data e horário mudam. 100% manual: nenhuma caixa é preenchida
    // automaticamente a partir da Etapa 3 — você escreve/cola tudo aqui do zero.

    // Monta a mensagem final DIRETO do conteúdo atual das 5 caixas — não depende de assignments/targets/ownFulls.
