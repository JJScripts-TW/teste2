        box.innerHTML = "";
        if (!assignments.length) { status.textContent = "Gere a distribuição (Etapa 5) e a sincronização (Etapa 6) primeiro."; return; }

        let html = "";
        assignments.forEach(function (a) {
            a.fulls.forEach(function (f) {
