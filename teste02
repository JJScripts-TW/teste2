    // ---------------- Mensagens INDIVIDUAIS (uma por jogador, com nome + botão de copiar) ----------------
    // As 4 caixinhas usam o MESMO formato da Etapa 2/3 ("Nome:N - coord coord coord", com bonus etc) —
    // por isso reaproveita parseNamedList pra ligar as 4 caixas por nick.

    // Mensagem individual: mesma estrutura de seções/spoiler do modelo padrão, mas só com as
    // coordenadas de UM jogador em cada campo (sem repetir o nome, já que a mensagem é dele).
    function buildIndividualMessage(player, dateStr, timeStr, data) {
        let msg = "⚔️ OPERAÇÃO — " + (dateStr || "(defina a data)") + " — " + player + " ⚔️\n\n" +
            "🕛 Horário de impacto: " + (timeStr || "(defina o horário)") + "\n";
        if (data.nt.length) {
            msg += "\n🎯 SEU(S) NT\n\n[spoiler]\n" + data.nt.join("\n") + "\n[/spoiler]\n";
        }
        if (data.fakes.length) {
            msg += "\n🎭 SEUS FAKES COORDENADOS\n\n[spoiler]\n" + data.fakes.join("\n") + "\n[/spoiler]\n";
        }
        if (data.fulls.length || data.semis.length) {
            msg += "\n⚔️ SEUS FULLS E SEMI-FULLS\n\n[spoiler]\n";
            if (data.fulls.length) msg += "FULLS\n\n" + data.fulls.join("\n") + "\n";
            if (data.fulls.length && data.semis.length) msg += "\n";
            if (data.semis.length) msg += "SEMI-FULLS\n\n" + data.semis.join("\n") + "\n";
            msg += "[/spoiler]\n";
        }
        if (data.bonus.length) {
            msg += "\n🎁 SEUS BÔNUS\n\n[spoiler]\n" + data.bonus.join("\n") + "\n[/spoiler]\n";
        }
        msg += "\n📌 Você é responsável pela sua própria noblagem: encaixe certinho os apoios colados e envie com anti-snipe.\n" +
            "Se não tiver tropa suficiente pro apoio, fale com algum amigo da tribo pra coordenar com você.\n\n" +
            "❗ Qualquer dúvida, NÃO me procure. Boa OP!";
        return msg;
    }

    function messageBlockHtml(title, text) {
        let h = '<div style="margin-bottom:10px;">';
        h += '<div style="color:' + gold + ';font-weight:700;margin-bottom:4px;">👤 ' + title + '</div>';
